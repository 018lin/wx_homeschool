/* AI 洞察：居中微凸起的蓝紫星光图标 */
.nav-bar__item--center {
  margin-top: -26rpx;
}

.nav-bar__icon--ai {
  width: 84rpx;
  height: 84rpx;
  background-size: 40rpx 40rpx, 100% 100%;
