.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  border-top: 2rpx solid rgba(225, 232, 240, 0.9);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: var(--z-nav);
  box-shadow: var(--shadow-up);
}

.nav-bar__item {
  flex: 1;
  min-width: 0;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-bar__label {
  font-size: var(--fs-base);
  color: var(--text-muted);
  line-height: 1.4;
  white-space: nowrap;
}

.nav-bar__item.active .nav-bar__label {
  color: var(--primary);
  font-weight: var(--fw-semibold);
}

.nav-bar__item.active::before {
  content: "";
  position: absolute;
  top: 0;
  width: 60rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: 0 0 6rpx 6rpx;
}

/* ---------- 图标式导航（管理员端 5 栏） ---------- */
.nav-bar__item--icon {
  height: 116rpx;
  justify-content: center;
  padding-top: 6rpx;
}

.nav-bar__item--icon.active::before {
  top: auto;
  bottom: 10rpx;
  width: 10rpx;
  height: 10rpx;
  background: var(--primary);
  border-radius: 50%;
}

.nav-bar__item--hover {
  opacity: 0.7;
}

.nav-bar__label {
  margin-top: 6rpx;
  font-size: var(--fs-xs);
  color: var(--text-muted);
  letter-spacing: 0;
}

.nav-bar__item--icon.active .nav-bar__label {
  color: var(--primary);
  font-weight: var(--fw-semibold);
}

.nav-bar__icon {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
}

