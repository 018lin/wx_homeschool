.cl-head {
  padding-bottom: 20rpx;
  margin-bottom: 24rpx;
}

.cl-head__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}

.cl-head__sub {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.cl-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.cl-counts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cl-detail {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.cd-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.cd-row:last-child {
  margin-bottom: 0;
}

.cd-row__label {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-muted);
}

.cd-row__body {
  flex: 1;
  min-width: 0;
}

.pick-list {
  max-height: 340rpx;
  margin-top: 8rpx;
}

.option__sub {
  font-size: 22rpx;
  opacity: 0.7;
}

.ph {
  color: #b6c0cd;
}
