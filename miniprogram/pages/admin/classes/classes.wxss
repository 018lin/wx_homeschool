.cl-head {
  padding-bottom: 20rpx;
  margin-bottom: 24rpx;
}

.cl-head__title {
  font-size: var(--fs-4xl);
  font-weight: var(--fw-bold);
  color: var(--text);
}

.cl-head__sub {
  font-size: var(--fs-md);
  color: var(--text-muted);
  margin-top: 8rpx;
}

.cl-name {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
}

/* 卡片头部操作区：详情 / 编辑 */
.cl-card__side {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

.cl-card__edit {
  font-size: var(--fs-base);
  color: var(--primary);
  background: var(--primary-light);
  border-radius: var(--radius-xs);
  padding: 8rpx 20rpx;
}

.cl-card__edit:active {
  opacity: 0.7;
}

/* 编辑模式：当前成员标签 */
.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.member-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 10rpx 6rpx 16rpx;
  border-radius: var(--radius-xs);
  background: var(--fill);
  border: 2rpx solid var(--line);
  font-size: var(--fs-base);
  color: var(--text-sub);
}

.member-tag--head {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: var(--fw-semibold);
}

.member-tag__badge {
  margin-left: 8rpx;
  font-size: var(--fs-xs);
  background: var(--primary);
  color: var(--white);
  border-radius: var(--radius-xs);
  padding: 2rpx 10rpx;
}

.member-tag__del {
  margin-left: 8rpx;
  padding: 0 6rpx;
  font-size: var(--fs-lg);
  font-weight: var(--fw-bold);
  color: var(--danger);
  line-height: 1;
}

/* 编辑模式：添加成员区 */
.member-add {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.option--add {
  border-style: dashed;
  color: var(--primary);
}

.cl-counts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cl-detail {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.cd-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.cd-row:last-child {
  margin-bottom: 0;
}

.cd-row__label {
  width: 100rpx;
  flex-shrink: 0;
  font-size: var(--fs-md);
  color: var(--text-muted);
}

.cd-row__body {
  flex: 1;
  min-width: 0;
}

.pick-list {
  max-height: 340rpx;
  margin-top: 8rpx;
}

.option__sub {
  font-size: var(--fs-sm);
  opacity: 0.7;
}

.ph {
  color: var(--text-placeholder);
}
