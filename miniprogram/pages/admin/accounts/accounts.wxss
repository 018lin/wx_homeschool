.ac-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.ac-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.ac-head__sub {
  font-size: var(--fs-base);
  opacity: 0.9;
  margin-top: 6rpx;
}

.title {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
}

.ph {
  color: var(--text-placeholder);
}

.search-box { margin-bottom: 12rpx; padding: 0 2rpx; }
.search-box__input { height: 82rpx; padding: 0 24rpx; border: 2rpx solid var(--line); border-radius: var(--radius-md); background: var(--white); font-size: var(--fs-md); }
.result-count { margin-bottom: 18rpx; color: var(--text-muted); font-size: var(--fs-sm); text-align: right; }

