<app-header title="账号管理" sub="" mode="back" variant="hero" />
<view class="page page-with-nav page--hero">
  <view class="segment">
    <view class="segment__item {{tab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="switchTab">
      全部 {{teachers.length + students.length + parents.length}}
    </view>
    <view class="segment__item {{tab === 'teachers' ? 'active' : ''}}" data-tab="teachers" bindtap="switchTab">
      教师 {{teachers.length}}
    </view>
    <view class="segment__item {{tab === 'students' ? 'active' : ''}}" data-tab="students" bindtap="switchTab">
      学生 {{students.length}}
    </view>
    <view class="segment__item {{tab === 'parents' ? 'active' : ''}}" data-tab="parents" bindtap="switchTab">
      家长 {{parents.length}}
    </view>
  </view>

  <view class="search-box">
    <input class="search-box__input" placeholder="搜索姓名 / 账号 / 年级" placeholder-class="ph" value="{{keyword}}" bindinput="onSearch" />
  </view>
  <view class="result-count">当前筛选 {{filteredCount}} 个账号</view>

  <button class="btn btn-primary btn-block mb-24" bindtap="openCreate" wx:if="{{!mode}}">+ 新建账号</button>

  <view class="loading-wrap" wx:if="{{loading}}">加载中…</view>
  <view class="card" wx:if="{{!loading && error}}"><view class="empty"><view class="empty__text">{{error}}</view><button class="btn btn-primary mt-16" bindtap="onRetry">重新加载</button></view></view>

  <block wx:if="{{tab === 'all' && !loading && !error}}">
    <view class="card" wx:for="{{allAccounts}}" wx:key="key" data-id="{{item.id}}" data-role="{{item.role}}" bindtap="openEdit">
      <view class="between">
        <view class="flex-1">
          <view class="title">{{item.name}} <text class="badge badge-gray">{{item.roleLabel}}</text></view>
          <view class="text-sm text-muted mt-8">{{item.account}}<text wx:if="{{item.grade}}"> · {{item.grade}}</text></view>
        </view>
        <text class="text-sm text-primary">编辑 ›</text>
      </view>
    </view>
    <view class="card" wx:if="{{!allAccounts.length}}"><view class="empty"><view class="empty__text">没有符合条件的账号</view></view></view>
  </block>

  <!-- 教师列表 -->
  <block wx:if="{{tab === 'teachers' && !loading && !error}}">
    <view class="card" wx:for="{{visibleTeachers}}" wx:key="id" data-id="{{item.id}}" bindtap="openEdit">
      <view class="between">
        <view class="flex-1">
          <view class="title">{{item.name}}</view>
          <view class="text-sm text-muted mt-8">{{item.account}}</view>
          <view class="text-sm text-muted" wx:if="{{item.subject}}">{{item.subject}}<text wx:if="{{item.employeeNo}}"> · {{item.employeeNo}}</text></view>
        </view>
        <text class="text-sm text-primary">编辑 ›</text>
      </view>
    </view>
    <view class="card" wx:if="{{!visibleTeachers.length}}">
      <view class="empty"><view class="empty__text">暂无教师账号</view></view>
    </view>
  </block>

  <!-- 学生列表 -->
  <block wx:if="{{tab === 'students' && !loading && !error}}">
    <view class="card" wx:for="{{visibleStudents}}" wx:key="id" data-id="{{item.id}}" bindtap="openEdit">
      <view class="between">
        <view class="flex-1">
          <view class="title">{{item.name}}</view>
          <view class="text-sm text-muted mt-8">{{item.account}} · {{item.grade || '未填年级'}}</view>
          <view class="text-sm text-muted" wx:if="{{item.parentAccount}}">
            家长 {{item.parentAccount}}（{{item.parentRelation}}）
          </view>
        </view>
        <text class="text-sm text-primary">编辑 ›</text>
      </view>
    </view>
    <view class="card" wx:if="{{!visibleStudents.length}}">
      <view class="empty"><view class="empty__text">暂无学生账号</view></view>
    </view>
  </block>

  <!-- 家长列表 -->
  <block wx:if="{{tab === 'parents' && !loading && !error}}">
    <view class="card" wx:for="{{visibleParents}}" wx:key="id" data-id="{{item.id}}" bindtap="openEdit">
      <view class="between">
        <view class="flex-1">
          <view class="title">{{item.name}}</view>
          <view class="text-sm text-muted mt-8">{{item.account}} · 绑定 {{item.childCount}} 个孩子</view>
        </view>
        <text class="text-sm text-primary">编辑 ›</text>
      </view>
    </view>
    <view class="card" wx:if="{{!visibleParents.length}}">
      <view class="empty"><view class="empty__text">暂无家长账号</view></view>
    </view>
  </block>
</view>

<!-- 表单弹窗
 * ⚠️ 必须放在 .page.page--hero 容器「外面」：
 * .page--hero 有 position:relative + z-index:2，会生成堆叠上下文，
 * 把弹层的 z-index(var(--z-modal)=1000) 限制在该上下文内，
 * 导致压不过同为根级兄弟的 <nav-bar>(z-index:200)，
 * 底部固定的导航栏会盖住 .modal-foot 的「保存」按钮 → 按钮点不动。 -->
<view class="modal-mask" wx:if="{{mode}}" catchtap="closeForm" catchtouchmove="noop">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-head">
        <text class="modal-head__title">{{mode === 'edit' ? '编辑账号' : '新建账号'}}</text>
        <text class="modal-head__close" bindtap="closeForm">取消</text>
      </view>

      <scroll-view scroll-y class="modal-body">
        <view class="field" wx:if="{{mode === 'create'}}">
      <view class="field__label">账号类型</view>
      <view class="wrap">
        <view
          class="option {{form.role === item.key ? 'active' : ''}}"
          wx:for="{{roles}}"
          wx:key="key"
          data-value="{{item.key}}"
          bindtap="pickRole"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field__label">账号（登录用）</view>
      <input class="field__input" placeholder="至少 3 个字符" placeholder-class="ph" value="{{form.account}}" data-key="account" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="field__label">密码</view>
      <input
        class="field__input"
        password
        placeholder="{{mode === 'edit' ? '留空表示不修改' : '至少 6 位'}}"
        placeholder-class="ph"
        value="{{form.password}}"
        data-key="password"
        bindinput="onFormInput"
      />
    </view>

    <view class="field">
      <view class="field__label">{{form.role === 'student' ? '学生姓名' : (form.role === 'parent' ? '家长姓名' : '教师姓名')}}</view>
      <input class="field__input" placeholder-class="ph" value="{{form.displayName}}" data-key="displayName" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="field__label">手机号（选填）</view>
      <input class="field__input" placeholder-class="ph" value="{{form.phone}}" data-key="phone" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="field__label">邮箱（选填）</view>
      <input class="field__input" placeholder-class="ph" value="{{form.email}}" data-key="email" bindinput="onFormInput" />
    </view>

    <!-- 教师专属 -->
    <block wx:if="{{form.role === 'teacher'}}">
      <view class="field">
        <view class="field__label">任教科目</view>
        <input class="field__input" placeholder-class="ph" value="{{form.subject}}" data-key="subject" bindinput="onFormInput" />
      </view>
      <view class="field">
        <view class="field__label">工号</view>
        <input class="field__input" placeholder-class="ph" value="{{form.employeeNo}}" data-key="employeeNo" bindinput="onFormInput" />
      </view>
    </block>

    <!-- 学生专属 -->
    <block wx:if="{{form.role === 'student'}}">
      <view class="field">
        <view class="field__label">年级 <text class="text-danger">*</text></view>
        <input class="field__input" placeholder="如：三年级" placeholder-class="ph" value="{{form.grade}}" data-key="grade" bindinput="onFormInput" />
      </view>
      <view class="field">
        <view class="field__label">性别</view>
        <view class="wrap">
          <view class="option {{form.gender === '男' ? 'active' : ''}}" data-value="男" bindtap="pickGender">男</view>
          <view class="option {{form.gender === '女' ? 'active' : ''}}" data-value="女" bindtap="pickGender">女</view>
        </view>
      </view>
      <view class="field">
        <view class="field__label">年龄</view>
        <input class="field__input" type="number" placeholder="3-18" placeholder-class="ph" value="{{form.age}}" data-key="age" bindinput="onFormInput" />
      </view>
      <view class="field">
        <view class="field__label">主要陪伴人</view>
        <input class="field__input" placeholder="如：妈妈" placeholder-class="ph" value="{{form.caregiver}}" data-key="caregiver" bindinput="onFormInput" />
      </view>
      <view class="field">
        <view class="field__label">兴趣（逗号分隔）</view>
        <input class="field__input" placeholder="如：阅读,绘画" placeholder-class="ph" value="{{form.interests}}" data-key="interests" bindinput="onFormInput" />
      </view>
      <view class="field">
        <view class="field__label">家庭备注</view>
        <textarea class="field__textarea field__textarea--sm" placeholder-class="ph" value="{{form.familyNote}}" data-key="familyNote" bindinput="onFormInput" />
      </view>
      <view class="field">
        <view class="field__label">关联家长账号</view>
        <input class="field__input" placeholder="填家长的登录账号" placeholder-class="ph" value="{{form.parentAccount}}" data-key="parentAccount" bindinput="onFormInput" />
        <view class="field__hint">该家长账号必须已存在</view>
      </view>
      <view class="field">
        <view class="field__label">与孩子关系</view>
        <input class="field__input" placeholder="家长" placeholder-class="ph" value="{{form.relation}}" data-key="relation" bindinput="onFormInput" />
      </view>
    </block>

      </scroll-view>

      <view class="modal-foot">
        <button class="btn btn-primary btn-block" bindtap="onSubmit" disabled="{{submitting}}">
          {{submitting ? '保存中…' : '保存'}}
        </button>
        <button
          wx:if="{{mode === 'edit'}}"
          class="btn btn-danger btn-block mt-16"
          bindtap="onDelete"
          disabled="{{submitting}}"
        >删除此账号</button>
      </view>
    </view>
  </view>

<nav-bar role="admin" active="overview" />
