<view class="page">
  <view class="loading-wrap" wx:if="{{loading}}">加载中…</view>

  <view class="card" wx:if="{{error}}">
    <view class="empty">
      <view class="empty__text">{{error}}</view>
      <view class="empty__hint">下拉可重新加载</view>
    </view>
  </view>

  <block wx:if="{{!loading}}">
    <view class="card" wx:if="{{worries.length}}">
      <view class="card-title">
        <text class="card-title__text">共 {{worries.length}} 条提交</text>
      </view>

      <view class="wr-item" wx:for="{{worries}}" wx:key="id">
        <view class="between">
          <view class="wr-item__name">{{item.studentName}}<text class="wr-item__grade" wx:if="{{item.grade}}">（{{item.grade}}）</text></view>
          <text class="text-sm text-muted">{{item.timeText}}</text>
        </view>
        <view class="wr-item__content">{{item.content}}</view>
      </view>
    </view>

    <view class="card" wx:else>
      <view class="empty">
        <view class="empty__icon">📮</view>
        <view class="empty__text">还没有学生提交小心事</view>
        <view class="empty__hint">学生在「我的小心事」提交后，内容会出现在这里</view>
      </view>
    </view>
  </block>
</view>
