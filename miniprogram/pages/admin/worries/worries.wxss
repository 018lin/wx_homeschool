.wr-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.wr-item:last-child {
  border-bottom: none;
}

.wr-item--active {
  padding: 24rpx 20rpx;
  margin: 0 -20rpx;
  border-radius: var(--radius-md);
  border-bottom: none;
  background: var(--fill);
  box-shadow: inset 0 0 0 2rpx var(--primary-light);
}

.wr-item__name {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
}

.wr-item__grade {
  font-weight: var(--fw-normal);
  font-size: var(--fs-md);
  color: var(--text-muted);
}

.wr-item__badges {
  margin-top: 10rpx;
}

.wr-item__content {
  font-size: var(--fs-lg);
  color: var(--text-body);
  line-height: 1.7;
  margin-top: 12rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ---------- 已发送的回复 ---------- */
.wr-item__reply {
  margin-top: 16rpx;
  background: var(--teal-light);
  border-radius: 0 14rpx 14rpx 0;
  border-left: 6rpx solid var(--teal);
  padding: 18rpx 20rpx;
}

.wr-item__reply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--fs-base);
  color: var(--teal);
  font-weight: var(--fw-semibold);
}

.wr-item__reply-time {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  font-weight: var(--fw-normal);
}

.wr-item__reply-text {
  font-size: var(--fs-md);
  color: var(--text);
  line-height: 1.7;
  margin-top: 10rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.wr-item__reply-tip {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-top: 10rpx;
}

/* ---------- 操作行 ---------- */
.wr-item__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.wr-item__hint {
  font-size: var(--fs-base);
  color: var(--text-muted);
}

.wr-item__act {
  padding: 10rpx 28rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-light);
  color: var(--primary);
  font-size: var(--fs-base);
  font-weight: var(--fw-semibold);
}

.wr-item__act:active {
  background: #d8e9ff;
}

/* ---------- 回复输入区 ---------- */
.wr-form {
  margin-top: 20rpx;
}

.wr-form__textarea {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  background: var(--white);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: var(--fs-lg);
  line-height: 1.7;
  color: var(--text);
}

.wr-counter {
  text-align: right;
  font-size: var(--fs-base);
  color: var(--text-muted);
  margin-top: 8rpx;
}

.wr-counter--full {
  color: var(--danger);
}

.wr-form__actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.wr-form__actions .btn {
  flex: 1;
}

.ph {
  color: var(--text-placeholder);
}