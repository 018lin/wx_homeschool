<app-header title="家长成长关注" sub="" mode="back" variant="hero" />
<view class="page page--hero">
  <view class="loading-wrap" wx:if="{{loading}}">加载中…</view>

  <view class="card" wx:if="{{error}}">
    <view class="empty">
      <view class="empty__text">{{error}}</view>
      <view class="empty__hint">下拉可重新加载</view>
    </view>
  </view>

  <block wx:if="{{!loading && !error}}">
    <view class="segment">
      <view
        class="segment__item {{filter === item.key ? 'active' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        data-filter="{{item.key}}"
        bindtap="switchFilter"
      >{{item.label}}</view>
    </view>

    <view class="card" wx:if="{{items.length}}">
      <view class="card-title">
        <text class="card-title__text">共 {{items.length}} 条成长关注</text>
        <text class="text-sm text-muted">共 {{all.length}} 条</text>
      </view>

      <view class="cc-item" wx:for="{{items}}" wx:key="id">
        <view class="between">
          <view class="cc-item__who">
            {{item.childName}}<text class="cc-item__grade" wx:if="{{item.grade}}">（{{item.grade}}）</text>
          </view>
          <text class="text-sm text-muted">{{item.timeText}}</text>
        </view>

        <view class="cc-item__title">{{item.title}}</view>
        <view class="cc-item__badges">
          <text class="tag" wx:if="{{item.category}}">{{item.category}}</text>
          <text class="tag">建议每次约 {{item.duration}} 分钟</text>
          <text class="badge" style="background:{{item.statusBg}};color:{{item.statusColor}}">{{item.statusText}}</text>
        </view>

        <view class="cc-item__label">观察到的情况</view>
        <view class="cc-item__body">{{item.behavior}}</view>
        <view class="cc-item__extra" wx:if="{{item.context}}">
          <text class="cc-item__extra-key">发生场景：</text>{{item.context}}
        </view>
        <view class="cc-item__extra" wx:if="{{item.frequency}}">
          <text class="cc-item__extra-key">出现频率：</text>{{item.frequency}}
        </view>
        <view class="cc-item__extra" wx:if="{{item.impact}}">
          <text class="cc-item__extra-key">造成的影响：</text>{{item.impact}}
        </view>
        <view class="cc-item__extra" wx:if="{{item.expectation}}">
          <text class="cc-item__extra-key">家长期望：</text>{{item.expectation}}
        </view>
        <view class="cc-item__extra" wx:if="{{item.constraints}}">
          <text class="cc-item__extra-key">家庭条件：</text>{{item.constraints}}
        </view>

        <view class="cc-item__reply" wx:if="{{item.teacherComment}}">
          <view class="cc-item__reply-head">老师处理</view>
          <view class="cc-item__reply-text">{{item.teacherComment}}</view>
        </view>
        <view class="cc-item__reply" wx:if="{{item.taskTitle}}">
          <view class="cc-item__reply-head">老师已确认并生成定制任务</view>
          <view class="cc-item__reply-text">{{item.taskTitle}}</view>
        </view>

        <view class="cc-item__foot">反馈人：{{item.parentName}}</view>
      </view>
    </view>

    <view class="card" wx:else>
      <view class="empty">
        <view class="empty__icon">📮</view>
        <view class="empty__text">暂无符合条件的成长关注</view>
        <view class="empty__hint">家长在首页右下角悬浮卡片提交后，内容会同步到这里</view>
      </view>
    </view>
  </block>
</view>
