page {
  background: var(--bg);
}

.ad-page {
  min-height: 100vh;
  background: var(--bg);
}

/* 内容区：与头图弧线叠压由全局 .page--hero 负责，此处只保留页面专属的卡片样式 */
.ad-body .card {
  border-radius: var(--radius-2xl);
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

/* ---------- 家校动态：左右双列磁贴 ---------- */
.fb-row {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.fb-tile {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 24rpx 22rpx 26rpx;
  border-radius: var(--radius-2xl);
  background: var(--white);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  transition: transform 0.15s ease;
}

.fb-tile::before {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -50rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  opacity: 0.5;
}

.fb-tile--warm::before {
  background: radial-gradient(circle, rgba(255, 143, 62, 0.22) 0%, rgba(255, 143, 62, 0) 70%);
}

.fb-tile--mint::before {
  background: radial-gradient(circle, rgba(21, 185, 130, 0.2) 0%, rgba(21, 185, 130, 0) 70%);
}

.fb-tile--hover {
  transform: scale(0.98);
  opacity: 0.92;
}

.fb-tile__icon {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 56rpx 56rpx;
}

.fb-tile__icon--worries {
  background-image: url("data:image/svg+xml;base64,");
}

.fb-tile__icon--concerns {
  background-image: url("data:image/svg+xml;base64,");
}

.fb-tile__badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background: #ff4d4f;
  color: var(--white);
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
  line-height: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(255, 77, 79, 0.3);
}

.fb-tile__title {
  position: relative;
  font-size: var(--fs-md);
  font-weight: var(--fw-bold);
  color: var(--text);
  margin-top: 18rpx;
}

.fb-tile__text {
  position: relative;
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-top: 8rpx;
  line-height: 1.5;
}

.fb-tile--active .fb-tile__title {
  color: var(--text);
}

/* ---------- 卡片头部：标题 + 胶囊入口 ---------- */
.ad-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ad-head-row__title {
  position: relative;
  display: flex;
  align-items: center;
  font-size: var(--fs-2xl);
  font-weight: var(--fw-bold);
  color: var(--text);
  padding-left: 20rpx;
}

.ad-head-row__title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 8rpx;
  height: 30rpx;
  margin-top: -15rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #0066dc 0%, #ff8f3e 100%);
}

.ad-count-chip {
  margin-left: 14rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  background: #f2f5f9;
  color: var(--text-muted);
  font-size: var(--fs-sm);
  font-weight: var(--fw-normal);
}

.pill-btn {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  font-size: var(--fs-base);
  font-weight: var(--fw-semibold);
  line-height: 1;
}

.pill-btn--light {
  background: var(--primary-light);
  color: var(--primary);
}

.pill-btn--primary {
  background: var(--grad-brand);
  color: var(--white);
  box-shadow: var(--shadow-primary);
}

.pill-btn--hover {
  opacity: 0.82;
}

.pill-btn__arrow {
  margin-left: 4rpx;
  font-size: var(--fs-lg);
  line-height: 1;
}

.pill-btn__plus {
  margin-right: 4rpx;
  font-size: var(--fs-xl);
  line-height: 1;
}

.ad-hint {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin: -6rpx 0 18rpx;
}

/* ---------- 账号概览三宫格 ---------- */
.ad-stats {
  display: flex;
  gap: 16rpx;
}

.ad-stat {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 26rpx 12rpx 22rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(160deg, #f8fbff 0%, #eef5fd 100%);
  overflow: hidden;
}

.ad-stat__value {
  position: relative;
  font-size: 48rpx;
  font-weight: var(--fw-bold);
  color: var(--text);
  line-height: 1.15;
  text-align: center;
}

.ad-stat__label {
  position: relative;
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-top: 8rpx;
  text-align: center;
}

/* 角落人物剪影水印 */
.ad-stat__wm {
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 72rpx;
  height: 72rpx;
  opacity: 0.07;
}

.ad-stat__wm::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 24rpx;
  height: 24rpx;
  margin-left: -12rpx;
  border-radius: 50%;
  background: var(--text);
}

.ad-stat__wm::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 2rpx;
  width: 58rpx;
  height: 34rpx;
  margin-left: -29rpx;
  border-radius: 30rpx 30rpx 6rpx 6rpx;
  background: var(--text);
}

.ad-stat__wm--teacher::before,
.ad-stat__wm--teacher::after {
  background: #0f62d6;
}
.ad-stat__wm--student::before,
.ad-stat__wm--student::after {
  background: var(--success-bright);
}
.ad-stat__wm--parent::before,
.ad-stat__wm--parent::after {
  background: var(--orange);
}

/* ---------- 班级列表子卡片 ---------- */
.cl-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cl-item {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-radius: var(--radius-xl);
  background: #f8fafc;
}

.cl-item:active {
  background: var(--fill-dark);
}

.cl-item__icon {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  margin-right: 18rpx;
  border-radius: var(--radius-lg);
  background-color: var(--primary-light);
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 40rpx 40rpx;
}

.cl-item__main {
  flex: 1;
  min-width: 0;
}

.cl-item__line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.cl-item__name {
  font-size: var(--fs-xl);
  font-weight: var(--fw-bold);
  color: var(--text);
}

.cl-item__grade {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  background: #eef5fd;
  color: var(--primary);
  font-size: var(--fs-sm);
}

.cl-item__meta {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-top: 6rpx;
}

.cl-item__arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: var(--fs-2xl);
  color: #c4ccd8;
}

.cl-counts {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.cl-list__loading {
  padding: 40rpx 0;
}

.cl-list__empty {
  padding: 36rpx 24rpx;
}

/* ---------- 班级详情弹窗 ---------- */
.cl-modal__name {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-bold);
  color: var(--text);
  margin-top: 16rpx;
}

.cl-modal__counts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 24rpx;
}

.cl-modal__tip {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--line);
}

.cd-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.cd-row:last-child {
  margin-bottom: 0;
}

.cd-row__label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: var(--fs-md);
  color: var(--text-muted);
}

.cd-row__body {
  flex: 1;
  min-width: 0;
}

/* 成员标签：紧凑化——压掉全局 .tag 的 1.6 行高与四周 margin，
   改用 flex + gap 控制间距，行高与左侧标签文字基线对齐 */
.cd-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 10rpx;
}

.cd-tags .tag {
  margin: 0;
  padding: 2rpx 12rpx;
  font-size: var(--fs-sm);
  line-height: 28rpx;
  font-weight: var(--fw-normal);
  border-radius: var(--radius-xs);
}

.ph {
  color: var(--text-placeholder);
}

/* ---------- 表单弹窗 ----------
 * .modal-* 系列已统一到 app.wxss 全局定义（与账号管理页共用同一套），
 * 此处不再重复声明，避免两处定义漂移。 */
