<view class="ad-page">
  <!-- 沉浸式弧形头图：全局 app-header 组件，与登录页一脉相承的天蓝渐变 -->
  <app-header title="管理员工作台" sub="{{heroSub}}" mode="home" variant="hero" />

  <view class="page page-with-nav page--hero ad-body">
    <view class="loading-wrap" wx:if="{{loading && !stats}}">加载中…</view>

    <!-- 家校动态反馈：左右双列磁贴 -->
    <view class="fb-row">
      <view class="fb-tile fb-tile--warm {{worriesNewCount ? 'fb-tile--active' : ''}}" bindtap="goWorries" hover-class="fb-tile--hover">
        <view class="fb-tile__icon fb-tile__icon--worries"></view>
        <view class="fb-tile__badge" wx:if="{{worriesNewCount}}">{{worriesNewCount > 99 ? '99+' : worriesNewCount}}</view>
        <view class="fb-tile__title">学生小心事</view>
        <view class="fb-tile__text">{{loading ? '加载中…' : (worriesNewCount ? '有' + worriesNewCount + '条新提交' : '暂无新的提交')}}</view>
      </view>

      <view class="fb-tile fb-tile--mint {{concernsNewCount ? 'fb-tile--active' : ''}}" bindtap="goConcerns" hover-class="fb-tile--hover">
        <view class="fb-tile__icon fb-tile__icon--concerns"></view>
        <view class="fb-tile__badge" wx:if="{{concernsNewCount}}">{{concernsNewCount > 99 ? '99+' : concernsNewCount}}</view>
        <view class="fb-tile__title">家长成长关注</view>
        <view class="fb-tile__text">{{loading ? '加载中…' : (concernsNewCount ? '有' + concernsNewCount + '条新提交' : '暂无新的提交')}}</view>
      </view>
    </view>

    <block wx:if="{{!loading || stats}}">
      <!-- 全校账号概览 -->
      <view class="card" wx:if="{{stats}}">
        <view class="ad-head-row">
          <view class="ad-head-row__title">账号概览</view>
          <view class="pill-btn pill-btn--light" bindtap="goAccounts" hover-class="pill-btn--hover">
            账号管理<text class="pill-btn__arrow">›</text>
          </view>
        </view>

        <view class="stat-grid ad-stats">
          <view class="stat ad-stat">
            <view class="ad-stat__wm ad-stat__wm--teacher"></view>
            <view class="ad-stat__value">{{stats.teacherCount || 0}}</view>
            <view class="ad-stat__label">教师</view>
          </view>
          <view class="stat ad-stat">
            <view class="ad-stat__wm ad-stat__wm--student"></view>
            <view class="ad-stat__value">{{stats.studentCount || 0}}</view>
            <view class="ad-stat__label">学生</view>
          </view>
          <view class="stat ad-stat">
            <view class="ad-stat__wm ad-stat__wm--parent"></view>
            <view class="ad-stat__value">{{stats.parentCount || 0}}</view>
            <view class="ad-stat__label">家长</view>
          </view>
        </view>
      </view>

      <!-- 班级管理：管理入口与已有列表合二为一 -->
      <view class="card">
        <view class="ad-head-row">
          <view class="ad-head-row__title">
            班级管理
            <text class="ad-count-chip" wx:if="{{!classesLoading}}">共 {{classes.length}} 个</text>
          </view>
          <view class="pill-btn pill-btn--primary" bindtap="goClasses" hover-class="pill-btn--hover">
            <text class="pill-btn__plus">+</text>管理/新建班级
          </view>
        </view>
        <view class="ad-hint">绑定师生与家长，提交动态将自动归入对应班级负责教师</view>

        <view class="loading-wrap cl-list__loading" wx:if="{{classesLoading}}">加载中…</view>

        <view class="cl-list" wx:elif="{{classes.length}}">
          <view class="cl-item" wx:for="{{classes}}" wx:key="id" data-id="{{item.id}}" bindtap="openClassModal">
            <view class="cl-item__icon"></view>
            <view class="cl-item__main">
              <view class="cl-item__line">
                <view class="cl-item__name">{{item.name}}</view>
                <text class="cl-item__grade" wx:if="{{item.grade}}">{{item.grade}}</text>
              </view>
              <view class="cl-item__meta">负责教师：{{item.headTeacherName || '未指定'}}</view>
              <view class="cl-counts">
                <text class="badge badge-primary">教师 {{item.teacherCount}}</text>
                <text class="badge badge-teal">学生 {{item.studentCount}}</text>
                <text class="badge badge-orange">家长 {{item.parentCount}}</text>
              </view>
            </view>
            <view class="cl-item__arrow">›</view>
          </view>
        </view>

        <view class="empty cl-list__empty" wx:else>
          <view class="empty__text">还没有班级</view>
          <view class="empty__hint">点击右上角「管理/新建班级」，从已有账号中组建班级</view>
        </view>
      </view>
    </block>
  </view>
</view>

<!-- 班级详情 / 编辑弹窗 -->
<view class="modal-mask" wx:if="{{classModalVisible}}" catchtap="closeClassModal" catchtouchmove="noop">
  <view class="modal-sheet" catchtap="noop">
    <view class="modal-head">
      <text class="modal-head__title">{{classEditMode ? '编辑班级' : '班级详情'}}</text>
      <text class="modal-head__close" bindtap="closeClassModal">{{classEditMode ? '取消' : '关闭'}}</text>
    </view>

    <scroll-view scroll-y class="modal-body">
      <!-- 班级详细资料 -->
      <block wx:if="{{!classEditMode && activeClass}}">
        <view class="cl-modal__name">{{activeClass.name}}</view>
        <view class="cl-modal__counts">
          <text class="badge badge-primary">教师 {{activeClass.teacherCount}}</text>
          <text class="badge badge-teal">学生 {{activeClass.studentCount}}</text>
          <text class="badge badge-orange">家长 {{activeClass.parentCount}}</text>
        </view>

        <view class="cd-row">
          <view class="cd-row__label">年级</view>
          <view class="cd-row__body">{{activeClass.grade || '未填'}}</view>
        </view>
        <view class="cd-row">
          <view class="cd-row__label">负责教师</view>
          <view class="cd-row__body">{{activeClass.headTeacherName || '未指定'}}</view>
        </view>
        <view class="cd-row">
          <view class="cd-row__label">任课教师</view>
          <view class="cd-row__body">
            <block wx:if="{{activeClass.teachers.length}}">
              <view class="cd-tags">
                <text class="tag" wx:for="{{activeClass.teachers}}" wx:for-item="t" wx:key="id">
                  {{t.name}}<text wx:if="{{t.id === activeClass.headTeacherId}}"> · 负责</text>
                </text>
              </view>
            </block>
            <text class="text-sm text-muted" wx:else>未绑定教师</text>
          </view>
        </view>
        <view class="cd-row">
          <view class="cd-row__label">学生</view>
          <view class="cd-row__body">
            <block wx:if="{{activeClass.students.length}}">
              <view class="cd-tags">
                <text class="tag" wx:for="{{activeClass.students}}" wx:for-item="s" wx:key="id">
                  {{s.name}}<text wx:if="{{s.grade}}">（{{s.grade}}）</text>
                </text>
              </view>
            </block>
            <text class="text-sm text-muted" wx:else>未绑定学生</text>
          </view>
        </view>
        <view class="cd-row">
          <view class="cd-row__label">家长</view>
          <view class="cd-row__body">
            <block wx:if="{{activeClass.parents.length}}">
              <view class="cd-tags">
                <text class="tag" wx:for="{{activeClass.parents}}" wx:for-item="p" wx:key="id">{{p.name}}</text>
              </view>
            </block>
            <text class="text-sm text-muted" wx:else>未绑定家长</text>
          </view>
        </view>

        <view class="field__hint cl-modal__tip">
          需要增减学生、家长等成员时，请前往「班级管理」页操作
        </view>
      </block>

      <!-- 编辑班级信息 -->
      <block wx:if="{{classEditMode}}">
        <view class="field">
          <view class="field__label">班级名称 <text class="text-danger">*</text></view>
          <input class="field__input" placeholder="如：四年级一班" placeholder-class="ph" value="{{classForm.name}}" data-key="name" bindinput="onClassFormInput" />
        </view>
        <view class="field">
          <view class="field__label">年级</view>
          <input class="field__input" placeholder="如：四年级" placeholder-class="ph" value="{{classForm.grade}}" data-key="grade" bindinput="onClassFormInput" />
        </view>
        <view class="field">
          <view class="field__label">负责教师 <text class="text-danger">*</text></view>
          <view class="field__hint">该班学生与家长的提交会归入这位教师的端</view>
          <view class="wrap mt-8">
            <view
              class="option {{item.id === classForm.headTeacherId ? 'active' : ''}}"
              wx:for="{{teacherOptions}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="pickClassHeadTeacher"
            >{{item.name}}<text class="option__sub" wx:if="{{item.subject}}"> {{item.subject}}</text></view>
          </view>
          <view class="text-sm text-muted mt-8" wx:if="{{!teacherOptions.length}}">
            暂无教师账号，请先在「账号管理」中创建
          </view>
        </view>
        <view class="field__hint">
          当前成员（教师 {{activeClass.teacherCount}} · 学生 {{activeClass.studentCount}} · 家长 {{activeClass.parentCount}}）将保持不变
        </view>
      </block>
    </scroll-view>

    <view class="modal-foot">
      <view class="flex gap-16" wx:if="{{!classEditMode}}">
        <button class="btn btn-outline flex-1" bindtap="goClasses">班级管理</button>
        <button class="btn btn-primary flex-1" bindtap="openClassEdit">编辑班级信息</button>
      </view>
      <view class="flex gap-16" wx:else>
        <button class="btn btn-outline flex-1" bindtap="cancelClassEdit">取消</button>
        <button class="btn btn-primary flex-1" bindtap="submitClassEdit" disabled="{{classSubmitting}}">
          {{classSubmitting ? '保存中…' : '保存修改'}}
        </button>
      </view>
    </view>
  </view>
</view>

<nav-bar role="admin" active="overview" />
