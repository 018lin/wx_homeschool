.al-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.al-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.al-head__sub {
  font-size: var(--fs-base);
  opacity: 0.85;
  margin-top: 6rpx;
}

.filter-grid { display: flex; gap: 16rpx; }
.filter-field { flex: 1; min-width: 0; }
.kind-filter { display: flex; flex-wrap: wrap; gap: 12rpx; }
.trend-chart { display: flex; height: 230rpx; align-items: flex-end; gap: 10rpx; }
.trend-day { flex: 1; height: 100%; display: flex; flex-direction: column; align-items: center; }
.trend-count, .trend-label { height: 34rpx; color: var(--text-muted); font-size: var(--fs-xs); }
.trend-track { position: relative; flex: 1; width: 34rpx; border-radius: var(--radius-sm); background: var(--fill-gray); overflow: hidden; }
.trend-fill { position: absolute; left: 0; right: 0; bottom: 0; border-radius: var(--radius-sm); background: var(--grad-primary); }
.rank-row { display: flex; align-items: center; gap: 12rpx; margin: 16rpx 0; }
.rank-no { width: 34rpx; color: var(--text-muted); font-size: var(--fs-sm); }
.rank-name { width: 130rpx; color: var(--text); font-size: var(--fs-md); }
.rank-track { flex: 1; height: 16rpx; border-radius: var(--radius-pill); background: var(--fill-gray); overflow: hidden; }
.rank-fill { height: 100%; border-radius: var(--radius-pill); background: var(--primary); }
.rank-count { width: 50rpx; color: var(--text-sub); font-size: var(--fs-sm); text-align: right; }

.ml {
  margin-left: 12rpx;
}

.al-title {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
  line-height: 1.5;
}

.al-content {
  font-size: var(--fs-md);
  color: var(--text-body);
  line-height: 1.75;
  margin-top: 12rpx;
  background: var(--fill);
  border-radius: var(--radius-sm);
  padding: 18rpx;
  white-space: pre-wrap;
}

.al-fb {
  margin-top: 16rpx;
  background: var(--teal-light);
  border-radius: var(--radius-sm);
  padding: 18rpx;
}

.al-fb__label {
  font-size: var(--fs-sm);
  color: var(--teal);
  font-weight: var(--fw-semibold);
  margin-bottom: 8rpx;
}

.al-fb__text {
  font-size: var(--fs-md);
  color: var(--text);
  line-height: 1.7;
  white-space: pre-wrap;
}

/* .picker-box 统一到 app.wxss 全局定义 */
