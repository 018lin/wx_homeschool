.eg-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.eg-head__title {
  font-size: 36rpx;
  font-weight: 700;
}

.eg-head__sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.eg-score-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.eg-score {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  min-width: 140rpx;
  text-align: center;
}

.eg-level {
  font-size: 30rpx;
  font-weight: 600;
}

.eg-evidence {
  font-size: 26rpx;
  color: #536174;
  line-height: 1.8;
}

.eg-list-item {
  font-size: 26rpx;
  color: #536174;
  line-height: 1.9;
  padding: 6rpx 0;
}
