.eg-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.eg-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.eg-head__sub {
  font-size: var(--fs-base);
  opacity: 0.9;
  margin-top: 6rpx;
}

.eg-score-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.eg-score {
  font-size: 72rpx;
  font-weight: var(--fw-bold);
  line-height: 1;
  min-width: 140rpx;
  text-align: center;
}

.eg-level {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
}

.eg-evidence {
  font-size: var(--fs-md);
  color: var(--text-sub);
  line-height: 1.8;
}

.eg-list-item {
  font-size: var(--fs-md);
  color: var(--text-sub);
  line-height: 1.9;
  padding: 6rpx 0;
}
