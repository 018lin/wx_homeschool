<app-header title="凌田家校" sub="家校共育 · 让成长被看见" mode="home" variant="hero" />
<view class="page page-with-nav page--hero">
  <!-- 非强制引导：无孩子 或 档案未完善 -->
  <view class="card" wx:if="{{!loading && children.length === 0}}">
    <view class="empty">
      <view class="empty__icon">👶</view>
      <view class="empty__text">还没有添加孩子</view>
      <view class="empty__hint">添加后即可收到老师的专属任务，现在不填也不影响使用其他功能</view>
    </view>
    <button class="btn btn-primary btn-block mt-24" bindtap="goChildren">去添加孩子</button>
    <button class="btn btn-outline btn-block mt-12" bindtap="goQuestionnaire">填写档案并添加（可选）</button>
  </view>

  <view class="card" wx:if="{{!loading && profileIncomplete}}">
    <view class="empty">
      <view class="empty__icon">📝</view>
      <view class="empty__text">孩子档案待完善</view>
      <view class="empty__hint">补充性别、年龄、陪伴人等信息，AI 任务建议会更贴合孩子（选填）</view>
    </view>
    <button class="btn btn-outline btn-block mt-24" bindtap="goChildren">去完善</button>
  </view>

  <!-- 本周任务 -->
  <view class="card" wx:if="{{task}}">
    <view class="card-title">
      <text class="card-title__text">本周任务</text>
      <text class="badge" style="background:{{task.statusBg}};color:{{task.statusColor}}">{{task.statusText}}</text>
    </view>

    <view class="task-title">{{task.title}}</view>
    <view class="task-meta">
      <text class="tag" wx:if="{{task.type}}">{{task.type}}</text>
      <text class="tag" wx:if="{{task.difficulty}}">{{task.difficulty}}</text>
      <text class="tag" wx:if="{{task.duration}}">{{task.duration}} 分钟</text>
    </view>
    <view class="quote" wx:if="{{task.goal}}">{{task.goal}}</view>

    <button class="btn btn-primary btn-block mt-24" bindtap="goTask">
      {{task.statusText === '已完成' ? '查看任务详情' : (task.statusText === '草稿待提交' ? '继续完成提交' : '去完成')}}
    </button>
  </view>

  <view class="card" wx:else>
    <view class="empty">
      <view class="empty__icon">📋</view>
      <view class="empty__text">本周还没有新任务</view>
      <view class="empty__hint">老师发布后会自动出现在这里</view>
    </view>
  </view>

  <!-- 老师反馈 -->
  <view class="card" wx:if="{{feedback}}">
    <view class="card-title">
      <text class="card-title__text">老师反馈</text>
      <text class="text-sm text-muted">{{feedback.timeText}}</text>
    </view>
    <view class="feedback-teacher">{{feedback.teacherName || '老师'}} · {{feedback.taskTitle || ''}}</view>
    <view class="feedback-comment">{{feedback.comment}}</view>
    <view class="mt-16" wx:if="{{feedback.tags.length}}">
      <text class="tag" wx:for="{{feedback.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 成长关注反馈状态 -->
  <view class="card" wx:if="{{parentTaskRequest}}" bindtap="goConcern">
    <view class="card-title">
      <text class="card-title__text">我反馈的成长关注</text>
      <text class="badge" style="background:{{parentTaskRequest.statusBg}};color:{{parentTaskRequest.statusColor}}">
        {{parentTaskRequest.statusText}}
      </text>
    </view>
    <view class="task-title">{{parentTaskRequest.title}}</view>
    <view class="quote quote-teal" wx:if="{{parentTaskRequest.taskTitle}}">
      老师生成的定制任务：{{parentTaskRequest.taskTitle}}
    </view>
    <view class="quote" wx:if="{{parentTaskRequest.teacher_comment}}">
      老师回复：{{parentTaskRequest.teacher_comment}}
    </view>
    <view class="text-sm text-muted mt-16" wx:if="{{!parentTaskRequest.taskTitle && !parentTaskRequest.teacher_comment}}">点击查看详情或再次反馈</view>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">加载中…</view>

  <!-- 右下角悬浮按钮：进入「成长关注」（风格与学生端一致） -->
  <view class="pc-fab" bindtap="goConcern" hover-class="none">
    <view class="pc-fab__plus">+</view>
  </view>
</view>

<nav-bar role="parent" active="home" />
