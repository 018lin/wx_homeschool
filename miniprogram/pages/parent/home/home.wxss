/* ---------- 任务卡 ---------- */
.task-title {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
  line-height: 1.5;
}

.task-meta {
  margin-top: 12rpx;
}

/* ---------- 反馈 ---------- */
.feedback-teacher {
  font-size: var(--fs-base);
  color: var(--text-sub);
  margin-bottom: 12rpx;
}

.feedback-comment {
  font-size: var(--fs-lg);
  color: var(--text);
  line-height: 1.7;
  background: var(--fill);
  border-radius: var(--radius-sm);
  padding: 20rpx;
}

/* ---------- 亲子参与 ---------- */
.engage-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.engage-score {
  font-size: 56rpx;
  font-weight: var(--fw-bold);
  line-height: 1;
  min-width: 110rpx;
  text-align: center;
}

.engage-level {
  font-size: var(--fs-lg);
  font-weight: var(--fw-semibold);
}

/* ---------- 快捷入口 ---------- */
.entry-grid {
  display: flex;
  flex-wrap: wrap;
}

.entry {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.entry__icon {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}

.entry__label {
  font-size: var(--fs-base);
  color: var(--text-sub);
}

/* ---------- 右下角悬浮按钮：成长关注（与学生端保持一致） ---------- */
.pc-fab {
  position: fixed;
  right: 36rpx;
  /* 避开底部导航条与安全区 */
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--grad-primary);
  box-shadow: 0 8rpx 24rpx rgba(0, 87, 184, .32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
}

.pc-fab:active {
  opacity: .85;
  transform: scale(.94);
}

.pc-fab__plus {
  font-size: 60rpx;
  line-height: 1;
  color: var(--white);
  font-weight: 300;
  margin-top: -6rpx;
}
