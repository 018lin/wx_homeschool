.tl-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.tl-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.tl-head__sub {
  font-size: var(--fs-base);
  opacity: 0.85;
  margin-top: 6rpx;
}

/* 时间线 */
.tl-item {
  position: relative;
  padding-left: 40rpx;
  margin-bottom: 24rpx;
}

.tl-item::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 24rpx;
  bottom: -24rpx;
  width: 2rpx;
  background: #dde5ef;
}

.tl-item:last-child::before {
  display: none;
}

.tl-item__dot {
  position: absolute;
  left: 0;
  top: 24rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--primary);
  border: 4rpx solid var(--white);
  box-shadow: 0 0 0 2rpx var(--primary);
}

.tl-item__dot.obs {
  background: var(--teal);
  box-shadow: 0 0 0 2rpx var(--teal);
}

.tl-item__body {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-xs);
}

.tl-item__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.tl-item__date {
  font-size: var(--fs-sm);
  color: var(--text-muted);
}

.tl-item__title {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
  line-height: 1.5;
}

.tl-item__content {
  font-size: var(--fs-lg);
  color: var(--text-body);
  line-height: 1.75;
  margin-top: 12rpx;
  white-space: pre-wrap;
}

.tl-imgs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tl-imgs__pic {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  margin: 0 12rpx 12rpx 0;
}

.tl-fb {
  margin-top: 16rpx;
  background: var(--teal-light);
  border-radius: var(--radius-sm);
  padding: 20rpx;
}

.tl-fb__label {
  font-size: var(--fs-base);
  color: var(--teal);
  font-weight: var(--fw-semibold);
  margin-bottom: 8rpx;
}

.tl-fb__text {
  font-size: var(--fs-md);
  color: var(--text);
  line-height: 1.7;
  white-space: pre-wrap;
}

.tl-item__time {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-top: 16rpx;
  text-align: right;
}
.tl-media { margin-top: 16rpx; }
.tl-audio { margin-bottom: 12rpx; padding: 18rpx; border-radius: var(--radius-sm); color: var(--primary); background: var(--primary-lighter); font-size: var(--fs-base); }
.tl-video { width: 100%; height: 320rpx; margin-bottom: 12rpx; border-radius: var(--radius-sm); background: var(--text); }
