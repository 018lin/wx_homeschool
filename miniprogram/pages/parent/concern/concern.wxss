.cn-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.cn-head__title {
  font-size: 36rpx;
  font-weight: 700;
}

.cn-head__sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
  line-height: 1.6;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
}

.ph {
  color: #b6c0cd;
}

.field__textarea--sm {
  min-height: 140rpx;
}
