.cn-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.cn-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.cn-head__sub {
  font-size: var(--fs-base);
  opacity: 0.9;
  margin-top: 8rpx;
  line-height: 1.6;
}

.task-title {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
  line-height: 1.5;
}

.ph {
  color: var(--text-placeholder);
}

/* .field__textarea--sm 统一到 app.wxss（min-height: 140rpx） */
