<view class="page page-with-nav">
  <view class="cn-head">
    <view class="cn-head__title">成长关注</view>
    <view class="cn-head__sub">把你观察到的情况告诉老师，一起商量怎么帮孩子</view>
  </view>

  <view class="segment">
    <view class="segment__item {{tab === 'list' ? 'active' : ''}}" data-tab="list" bindtap="switchTab">我的提交</view>
    <view class="segment__item {{tab === 'create' ? 'active' : ''}}" data-tab="create" bindtap="switchTab">提交新关注</view>
  </view>

  <!-- 列表 -->
  <block wx:if="{{tab === 'list'}}">
    <view class="loading-wrap" wx:if="{{loading}}">加载中…</view>

    <view class="card" wx:if="{{!loading && !items.length}}">
      <view class="empty">
        <view class="empty__icon">💬</view>
        <view class="empty__text">还没有提交过成长关注</view>
        <view class="empty__hint">切换到「提交新关注」，把你的观察告诉老师</view>
      </view>
    </view>

    <view class="card" wx:for="{{items}}" wx:key="id">
      <view class="between mb-16">
        <text class="badge" style="background:{{item.statusBg}};color:{{item.statusColor}}">{{item.statusText}}</text>
        <text class="text-sm text-muted">{{item.timeText}}</text>
      </view>
      <view class="task-title">{{item.title}}</view>
      <view class="mt-12" wx:if="{{item.category}}">
        <text class="tag">{{item.category}}</text>
      </view>
      <view class="quote">{{item.behavior}}</view>
      <view class="quote quote-teal" wx:if="{{item.teacherComment}}">
        <text class="bold">老师回复：</text>{{item.teacherComment}}
      </view>
    </view>
  </block>

  <!-- 提交表单 -->
  <block wx:else>
    <view class="card">
      <view class="field">
        <view class="field__label">关注方向（选填）</view>
        <view class="wrap">
          <view
            class="option {{category === item ? 'active' : ''}}"
            wx:for="{{categories}}"
            wx:key="*this"
            data-value="{{item}}"
            bindtap="pickCategory"
          >{{item}}</view>
        </view>
      </view>

      <view class="field">
        <view class="field__label">你观察到的具体情况 <text class="text-danger">*</text></view>
        <textarea
          class="field__textarea"
          placeholder="比如：最近写作业时容易急躁，遇到不会的题目会直接放弃，需要提醒三四次才愿意再试一次…"
          placeholder-class="ph"
          maxlength="1200"
          value="{{observedBehavior}}"
          data-key="observedBehavior"
          bindinput="onInput"
        />
        <view class="field__hint">{{observedBehavior.length}} / 1200，至少 4 个字</view>
      </view>

      <view class="field">
        <view class="field__label">通常发生在什么场景（选填）</view>
        <input
          class="field__input"
          placeholder="如：放学回家写作业前"
          placeholder-class="ph"
          value="{{context}}"
          data-key="context"
          bindinput="onInput"
        />
      </view>

      <view class="field">
        <view class="field__label">发生频率（选填）</view>
        <input
          class="field__input"
          placeholder="如：一周三四次"
          placeholder-class="ph"
          value="{{frequency}}"
          data-key="frequency"
          bindinput="onInput"
        />
      </view>

      <view class="field">
        <view class="field__label">对孩子的影响（选填）</view>
        <textarea
          class="field__textarea field__textarea--sm"
          placeholder="这件事对你或孩子造成了什么困扰？"
          placeholder-class="ph"
          maxlength="800"
          value="{{impact}}"
          data-key="impact"
          bindinput="onInput"
        />
      </view>

      <view class="field">
        <view class="field__label">你希望达成什么（选填）</view>
        <textarea
          class="field__textarea field__textarea--sm"
          placeholder="希望孩子能…"
          placeholder-class="ph"
          maxlength="800"
          value="{{parentExpectation}}"
          data-key="parentExpectation"
          bindinput="onInput"
        />
      </view>

      <view class="field">
        <view class="field__label">家里的实际限制（选填）</view>
        <textarea
          class="field__textarea field__textarea--sm"
          placeholder="如：晚上只有 20 分钟能陪伴，老人主要照顾起居"
          placeholder-class="ph"
          maxlength="800"
          value="{{familyConstraints}}"
          data-key="familyConstraints"
          bindinput="onInput"
        />
      </view>

      <view class="field">
        <view class="field__label">希望每次投入的时间</view>
        <view class="wrap">
          <view
            class="option {{duration === item ? 'active' : ''}}"
            wx:for="{{durations}}"
            wx:key="*this"
            data-value="{{item}}"
            bindtap="pickDuration"
          >{{item}} 分钟</view>
        </view>
      </view>

      <button class="btn btn-primary btn-block" bindtap="onSubmit" disabled="{{submitting}}">
        {{submitting ? '提交中…' : '提交给老师'}}
      </button>
      <view class="field__hint text-center mt-16">提交后老师会收到并回复，你可以在「我的提交」里查看</view>
    </view>
  </block>
</view>

<nav-bar role="parent" active="concern" />
