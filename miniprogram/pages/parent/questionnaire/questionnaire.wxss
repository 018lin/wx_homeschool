.q-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 36rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.q-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.q-head__sub {
  font-size: var(--fs-base);
  opacity: 0.9;
  margin-top: 8rpx;
  line-height: 1.6;
}

.ph {
  color: var(--text-placeholder);
}
