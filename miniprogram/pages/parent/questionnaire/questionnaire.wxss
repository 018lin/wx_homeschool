.q-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.q-head__title {
  font-size: 36rpx;
  font-weight: 700;
}

.q-head__sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
  line-height: 1.6;
}

.ph {
  color: #b6c0cd;
}
