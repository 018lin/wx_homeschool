.noti-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.noti-head__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.noti-head__title {
  font-size: 36rpx;
  font-weight: 700;
}

.noti-head__sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.noti-head__btn {
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.noti-item {
  position: relative;
}

.noti-item.unread {
  border-left: 6rpx solid #0057b8;
}

.noti-item__head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.noti-item__time {
  font-size: 22rpx;
  color: #8795a7;
  margin-left: 16rpx;
}

.noti-item__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #b42318;
  margin-left: auto;
}

.noti-item__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
}

.noti-item__content {
  font-size: 27rpx;
  color: #536174;
  line-height: 1.7;
  margin-top: 10rpx;
  white-space: pre-wrap;
}

.noti-item__sender {
  font-size: 22rpx;
  color: #8795a7;
  margin-top: 14rpx;
  text-align: right;
}
.noti-item__hide { margin-top: 14rpx; color: #8795a7; font-size: 21rpx; text-align: right; }
.subscribe-btn { margin: 0 0 0 16rpx; min-width: 120rpx; height: 64rpx; line-height: 64rpx; border: 0; border-radius: 999rpx; color: #fff; background: #0057b8; font-size: 24rpx; }
