.noti-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.noti-head__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.noti-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.noti-head__sub {
  font-size: var(--fs-base);
  opacity: 0.85;
  margin-top: 6rpx;
}

.noti-head__btn {
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-pill);
  font-size: var(--fs-base);
}

.noti-item {
  position: relative;
}

.noti-item.unread {
  border-left: 6rpx solid var(--primary);
}

.noti-item__head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.noti-item__time {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-left: 16rpx;
}

.noti-item__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--danger);
  margin-left: auto;
}

.noti-item__title {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
  line-height: 1.5;
}

.noti-item__content {
  font-size: var(--fs-md);
  color: var(--text-sub);
  line-height: 1.7;
  margin-top: 10rpx;
  white-space: pre-wrap;
}

.noti-item__sender {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-top: 14rpx;
  text-align: right;
}
.noti-item__hide { margin-top: 14rpx; color: var(--text-muted); font-size: var(--fs-sm); text-align: right; }
.subscribe-btn { margin: 0 0 0 16rpx; min-width: 120rpx; height: 64rpx; line-height: 64rpx; border: 0; border-radius: var(--radius-pill); color: var(--white); background: var(--primary); font-size: var(--fs-base); }
