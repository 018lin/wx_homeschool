.feedback-head {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  color: var(--white);
  background: var(--grad-primary);
}
.feedback-head__title { font-size: var(--fs-3xl); font-weight: var(--fw-bold); }
.feedback-head__sub { margin-top: 8rpx; font-size: var(--fs-base); opacity: .88; }
.filter-row { display: flex; gap: 16rpx; }
.filter-item { flex: 1; min-width: 0; }
.feedback-card__title { color: var(--text); font-size: var(--fs-xl); font-weight: var(--fw-semibold); }
.feedback-card__task {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: var(--radius-sm);
  background: var(--fill);
  color: var(--text-sub);
  font-size: var(--fs-md);
  line-height: 1.65;
}
.feedback-card__teacher { margin-top: 18rpx; color: var(--teal); font-size: var(--fs-base); font-weight: var(--fw-semibold); }
.feedback-card__comment { margin-top: 10rpx; color: var(--text); font-size: var(--fs-lg); line-height: 1.75; white-space: pre-wrap; }

/* .picker-box 统一到 app.wxss 全局定义（原 padding/圆角/字号与它页不一致） */
