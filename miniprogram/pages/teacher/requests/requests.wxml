<app-header title="家长成长关注" sub="" mode="back" variant="hero" />
<view class="page page-with-nav page--hero">
  <view class="segment">
    <view class="segment__item {{filter === 'pending' ? 'active' : ''}}" data-filter="pending" bindtap="switchFilter">待处理</view>
    <view class="segment__item {{filter === 'approved' ? 'active' : ''}}" data-filter="approved" bindtap="switchFilter">已处理</view>
    <view class="segment__item {{filter === 'rejected' ? 'active' : ''}}" data-filter="rejected" bindtap="switchFilter">未采纳</view>
    <view class="segment__item {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="switchFilter">全部</view>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">加载中…</view>

  <view class="card" wx:if="{{!loading && !items.length}}">
    <view class="empty">
      <view class="empty__icon">💬</view>
      <view class="empty__text">没有需要处理的关注</view>
    </view>
  </view>

  <view class="card" wx:for="{{items}}" wx:key="id">
    <view class="between mb-12">
      <view class="align-center">
        <text class="bold">{{item.childName}}</text>
        <text class="badge badge-gray ml">{{item.grade}}</text>
        <text class="badge badge-primary ml" wx:if="{{item.category}}">{{item.category}}</text>
      </view>
      <text class="badge" style="background:{{item.statusBg}};color:{{item.statusColor}}">{{item.statusText}}</text>
    </view>

    <view class="rq-title">{{item.title}}</view>
    <view class="text-sm text-muted mt-8">来自 {{item.parentName}} · {{item.timeText}}</view>

    <view class="rq-block" wx:if="{{item.behavior}}">
      <view class="rq-block__label">家长观察到的情况</view>
      <view class="rq-block__body">{{item.behavior}}</view>
    </view>
    <view class="rq-block" wx:if="{{item.context}}">
      <view class="rq-block__label">发生场景</view>
      <view class="rq-block__body">{{item.context}}</view>
    </view>
    <view class="rq-block" wx:if="{{item.frequency}}">
      <view class="rq-block__label">频率</view>
      <view class="rq-block__body">{{item.frequency}}</view>
    </view>
    <view class="rq-block" wx:if="{{item.impact}}">
      <view class="rq-block__label">影响</view>
      <view class="rq-block__body">{{item.impact}}</view>
    </view>
    <view class="rq-block" wx:if="{{item.expectation}}">
      <view class="rq-block__label">家长期望</view>
      <view class="rq-block__body">{{item.expectation}}</view>
    </view>
    <view class="rq-block" wx:if="{{item.constraints}}">
      <view class="rq-block__label">家庭限制</view>
      <view class="rq-block__body">{{item.constraints}}</view>
    </view>
    <view class="plan" wx:if="{{item.aiPlan}}">
      <view class="plan__head">
        <text class="plan__head-title">AI 总结（仅教师可见）</text>
        <text class="badge badge-danger ml" wx:if="{{item.aiPlan.needReview}}">需专业支持</text>
      </view>

      <view class="plan__warn" wx:if="{{item.aiPlan.needReview}}">
        描述中出现了需要优先由班主任或学校专业人员进一步了解的信号，不建议仅依靠家庭任务处理。
      </view>

      <view class="plan__section" wx:for="{{item.aiPlan.summarySections}}" wx:for-item="sec" wx:key="label">
        <view class="plan__label">{{sec.label}}</view>
        <view class="plan__body">{{sec.body}}</view>
      </view>

      <view class="plan__task" wx:if="{{item.aiPlan.title}}">
        <text class="plan__task-title">AI 任务草案 · {{item.aiPlan.title}}</text>
        <text class="plan__task-meta" wx:if="{{item.aiPlan.meta}}">{{item.aiPlan.meta}}</text>
      </view>

      <view class="plan__section" wx:for="{{item.aiPlan.taskSections}}" wx:for-item="sec" wx:key="label">
        <view class="plan__label">{{sec.label}}</view>
        <view class="plan__body">{{sec.body}}</view>
      </view>
    </view>

    <view class="quote" wx:elif="{{item.aiPlanText}}">
      <text class="bold">AI 建议方案：</text>{{item.aiPlanText}}
    </view>
    <view class="quote" wx:if="{{item.teacherComment}}">
      <text class="bold">我的回复：</text>{{item.teacherComment}}
    </view>
    <view class="field__hint mt-12" wx:if="{{item.taskTitle}}">已生成任务：{{item.taskTitle}}</view>

    <!-- 审核区 -->
    <block wx:if="{{item.status === 'pending'}}">
      <button class="btn btn-outline btn-block mt-24" wx:if="{{reviewId !== item.id}}" data-id="{{item.id}}" bindtap="openReview">
        查看反馈并处理
      </button>

      <block wx:else>
        <view class="section-title">确认实施后将生成定制任务并推送给家长与学生</view>
        <view class="field__hint mb-16">{{hasDraft ? '已按 AI 任务草案预填，你可直接修改后再确认' : '该反馈暂无 AI 草案，请自行设计任务内容'}}</view>

        <view class="field">
          <view class="field__label">任务标题</view>
          <input class="field__input" value="{{title}}" data-key="title" bindinput="onInput" placeholder-class="ph" placeholder="任务标题" />
        </view>
        <view class="field">
          <view class="field__label">目标</view>
          <input class="field__input" value="{{goal}}" data-key="goal" bindinput="onInput" placeholder-class="ph" placeholder="任务目标" />
        </view>
        <view class="field">
          <view class="field__label">步骤</view>
          <textarea class="field__textarea field__textarea--sm" value="{{steps}}" data-key="steps" bindinput="onInput" placeholder-class="ph" placeholder="具体步骤" />
        </view>
        <view class="field">
          <view class="field__label">时长（分钟）</view>
          <input class="field__input" type="number" value="{{duration}}" data-key="duration" bindinput="onInput" placeholder-class="ph" placeholder="20" />
        </view>
        <view class="field">
          <view class="field__label">难度</view>
          <view class="wrap">
            <view class="option {{difficulty === it ? 'active' : ''}}" wx:for="{{difficulties}}" wx:for-item="it" wx:key="*this" data-value="{{it}}" bindtap="pickDifficulty">{{it}}</view>
          </view>
        </view>

        <view class="field">
          <view class="field__label">回复家长（拒绝时必填）</view>
          <textarea
            class="field__textarea field__textarea--sm"
            placeholder="写一句家长能直接看懂的话…"
            placeholder-class="ph"
            maxlength="500"
            value="{{comment}}"
            data-key="comment"
            bindinput="onInput"
          />
        </view>

        <view class="rq-actions">
          <button class="btn btn-gray" bindtap="closeReview">取消</button>
          <button class="btn btn-outline" data-decision="rejected" bindtap="onReview" disabled="{{submitting}}">暂不采纳</button>
          <button class="btn btn-primary" data-decision="approved" bindtap="onReview" disabled="{{submitting}}">确认并推送</button>
        </view>
      </block>
    </block>
  </view>
</view>

<nav-bar role="teacher" active="workbench" />
