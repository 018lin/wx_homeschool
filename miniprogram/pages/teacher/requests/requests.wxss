.rq-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.rq-head__title {
  font-size: 36rpx;
  font-weight: 700;
}

.rq-head__sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
  line-height: 1.6;
}

.ml {
  margin-left: 12rpx;
}

.rq-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
  margin-top: 8rpx;
}

.rq-block {
  margin-top: 18rpx;
}

.rq-block__label {
  font-size: 24rpx;
  color: #8795a7;
  margin-bottom: 6rpx;
}

.rq-block__body {
  font-size: 27rpx;
  color: #374151;
  line-height: 1.75;
  background: #f8fbff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  white-space: pre-wrap;
}

.rq-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.rq-actions .btn {
  flex: 1;
  padding: 0 16rpx;
  font-size: 26rpx;
}

.ph {
  color: #b6c0cd;
}

.field__textarea--sm {
  min-height: 140rpx;
}
