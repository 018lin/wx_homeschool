.rq-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.rq-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.rq-head__sub {
  font-size: var(--fs-base);
  opacity: 0.9;
  margin-top: 6rpx;
  line-height: 1.6;
}

.ml {
  margin-left: 12rpx;
}

.rq-title {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
  line-height: 1.5;
  margin-top: 8rpx;
}

.rq-block {
  margin-top: 18rpx;
}

.rq-block__label {
  font-size: var(--fs-base);
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.rq-block__body {
  font-size: var(--fs-md);
  color: var(--text-body);
  line-height: 1.75;
  background: var(--fill);
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
  white-space: pre-wrap;
}

/* ---------- AI 建议方案 ---------- */
.plan {
  margin-top: 20rpx;
  background: var(--teal-light);
  border-left: 6rpx solid var(--teal);
  border-radius: 0 16rpx 16rpx 0;
  padding: 24rpx 24rpx 14rpx;
}

.plan__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan__head-title {
  font-size: var(--fs-lg);
  font-weight: var(--fw-bold);
  color: var(--teal);
}

.plan__warn {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--danger-light);
  border-radius: var(--radius-sm);
  font-size: var(--fs-md);
  color: var(--danger);
  line-height: 1.7;
}

.plan__task {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: var(--white);
  border-radius: var(--radius-sm);
}

.plan__task-title {
  display: block;
  font-size: var(--fs-lg);
  font-weight: var(--fw-semibold);
  color: var(--text);
  line-height: 1.5;
}

.plan__task-meta {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--teal);
}

.plan__section {
  margin-top: 18rpx;
}

.plan__label {
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  color: var(--teal);
  margin-bottom: 6rpx;
}

.plan__body {
  font-size: var(--fs-md);
  color: var(--text-sub);
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}

.rq-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.rq-actions .btn {
  flex: 1;
  padding: 0 16rpx;
  font-size: var(--fs-md);
}

.ph {
  color: var(--text-placeholder);
}

/* .field__textarea--sm 统一到 app.wxss（min-height: 140rpx） */
