.pb-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.pb-head__title {
  font-size: 36rpx;
  font-weight: 700;
}

.pb-head__sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.btn-ai-generate {
  margin: -4rpx 0 28rpx;
  background: #e9f8f0;
  color: #0f766e;
  border: 2rpx solid #9bd9c2;
}

.btn-ai-generate:active {
  background: #d7f2e5;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f8fbff;
  border: 2rpx solid #e1e8f0;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.picker-box__arrow {
  color: #8795a7;
  font-size: 24rpx;
}

.ph {
  color: #b6c0cd;
}

.field__textarea--sm {
  min-height: 140rpx;
}
