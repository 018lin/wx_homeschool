.pb-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.pb-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.pb-head__sub {
  font-size: var(--fs-base);
  opacity: 0.9;
  margin-top: 6rpx;
}

.btn-ai-generate {
  margin: -4rpx 0 28rpx;
  background: var(--teal-light);
  color: var(--teal);
  border: 2rpx solid #9bd9c2;
}

.btn-ai-generate:active {
  background: #d7f2e5;
}

.ph {
  color: var(--text-placeholder);
}

