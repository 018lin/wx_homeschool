.ai-text {
  font-size: var(--fs-md);
  color: var(--text-body);
  line-height: 1.8;
  white-space: pre-wrap;
}

.ov-insight {
  font-size: var(--fs-md);
  color: var(--text-sub);
  line-height: 1.9;
}

.ov-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ph {
  color: var(--text-placeholder);
}


.ai-state { margin-bottom: 20rpx; padding: 18rpx 22rpx; border-radius: var(--radius-md); background: var(--primary-lighter); color: var(--primary); }
.ai-state.done { background: var(--teal-light); color: var(--success); }
.ai-state.failed { background: var(--danger-light); color: var(--danger); }
.ai-state.unconfigured { background: var(--fill-dark); color: var(--text-sub); }
.ai-state__title { font-size: var(--fs-md); font-weight: var(--fw-semibold); }
.ai-state__error, .ai-state__stale { margin-top: 8rpx; font-size: var(--fs-sm); line-height: 1.55; }
.notice-actions { display: flex; gap: 14rpx; margin-top: 14rpx; }
.notice-actions .btn { flex: 1; }

/* .field__textarea--sm 统一到 app.wxss（min-height: 140rpx） */
