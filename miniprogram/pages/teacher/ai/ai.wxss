/* AI 洞察 · 对话式界面（参考 DeepSeek / ChatGPT 移动端） */
page {
  height: 100%;
  background: #f7f8fa;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f8fa;
  box-sizing: border-box;
}

/* ---------- 顶部操作栏 ---------- */
.chat-topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 28rpx 6rpx;
}

.chat-topbar__hint {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-muted);
}

.chat-topbar__actions {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
}

.chat-topbar__btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #e5e9f0;
  color: var(--text-sub);
  font-size: 23rpx;
  line-height: 1.5;
}

.chat-topbar__btn:active {
  background: #eef4ff;
  border-color: var(--primary);
  color: var(--primary);
}

/* ---------- 对话滚动区 ---------- */
.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-body {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: 0 28rpx 24rpx;
  box-sizing: border-box;
}

.chat-tail {
  height: 12rpx;
  flex-shrink: 0;
}

/* ---------- 空白态 ---------- */
.chat-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 60rpx;
  text-align: center;
}

.chat-hero__mark {
  width: 112rpx;
  height: 112rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 34rpx rgba(0, 87, 184, 0.18);
}

.chat-hero__title {
  margin-top: 36rpx;
  font-size: 46rpx;
  font-weight: 600;
  color: #111827;
  letter-spacing: 1rpx;
}

.chat-hero__sub {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--text-muted);
}

.chat-suggests {
  width: 100%;
  margin-top: 52rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.chat-suggest {
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid #e8ecf2;
  font-size: 27rpx;
  line-height: 1.55;
  color: #374151;
  text-align: left;
}

.chat-suggest:active {
  background: #eef4ff;
  border-color: var(--primary);
}

/* ---------- 消息 ---------- */
.msg {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-top: 18rpx;
}

.msg.user {
  flex-direction: row-reverse;
}

.msg__avatar {
  width: 60rpx;
  height: 60rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg__col {
  max-width: 78%;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.msg.user .msg__col {
  align-items: flex-end;
}

.msg__bubble {
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #1f2937;
  font-size: 29rpx;
  line-height: 1.75;
  word-break: break-word;
  box-shadow: 0 2rpx 10rpx rgba(15, 40, 80, 0.05);
}

.msg.assistant .msg__bubble {
  border-top-left-radius: 8rpx;
}

.msg.user .msg__bubble {
  background: var(--primary);
  color: #fff;
  border-top-right-radius: 8rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 87, 184, 0.18);
}

.msg__text {
  white-space: pre-wrap;
  word-break: break-word;
}

/* 思考中的三点动画 */
.msg__typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 6rpx;
}

.msg__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b6c0cd;
  animation: aiDot 1.2s infinite ease-in-out;
}

.msg__dot:nth-child(2) { animation-delay: 0.18s; }
.msg__dot:nth-child(3) { animation-delay: 0.36s; }

@keyframes aiDot {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40% { transform: translateY(-8rpx); opacity: 1; }
}

.msg__foot {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  padding: 0 10rpx;
}

.msg__link {
  font-size: 21rpx;
  color: var(--text-muted);
}

.msg__link:active {
  color: var(--primary);
}

.msg__meta {
  margin-top: 10rpx;
  padding: 0 10rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--text-muted);
}

.msg__error {
  margin-top: 10rpx;
  padding: 0 10rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--danger);
}

/* ---------- 底部输入区 ---------- */
.composer {
  flex-shrink: 0;
  padding: 14rpx 28rpx 18rpx;
  /* 让出底部导航栏 + 安全区高度 */
  margin-bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}

.composer__box {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 12rpx 12rpx 12rpx 16rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 2rpx solid #e5e9f0;
  box-shadow: 0 8rpx 26rpx rgba(15, 40, 80, 0.06);
}

.composer__input {
  flex: 1;
  min-width: 0;
  min-height: 56rpx;
  max-height: 220rpx;
  padding: 12rpx 0;
  font-size: 29rpx;
  line-height: 1.6;
  color: var(--text);
}

/* ---------- 长按语音输入 ---------- */
.composer__mic {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 2rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2f7;
  transition: background .18s ease, transform .18s ease;
}

.composer__mic:active {
  transform: scale(0.94);
}

.composer__mic.active {
  background: var(--primary);
}

.composer__mic.busy {
  opacity: 0.55;
}

.composer__mic-icon {
  position: relative;
  width: 34rpx;
  height: 44rpx;
}

.composer__mic-head {
  position: absolute;
  top: 0;
  left: 8rpx;
  width: 18rpx;
  height: 28rpx;
  border: 3rpx solid #5b6b80;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.composer__mic-stem {
  position: absolute;
  left: 3rpx;
  top: 12rpx;
  width: 28rpx;
  height: 24rpx;
  border: 3rpx solid #5b6b80;
  border-top: 0;
  border-radius: 0 0 16rpx 16rpx;
  box-sizing: border-box;
}

.composer__mic-base {
  position: absolute;
  left: 16rpx;
  bottom: 0;
  width: 3rpx;
  height: 10rpx;
  background: #5b6b80;
}

.composer__mic-base::after {
  content: "";
  position: absolute;
  left: -10rpx;
  bottom: 0;
  width: 22rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #5b6b80;
}

.composer__mic.active .composer__mic-head,
.composer__mic.active .composer__mic-stem {
  border-color: #fff;
}

.composer__mic.active .composer__mic-base,
.composer__mic.active .composer__mic-base::after {
  background: #fff;
}

/* 录音中的呼吸光圈 */
.composer__mic-ring {
  position: absolute;
  inset: -8rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(0, 87, 184, 0.35);
  animation: micPulse 1.1s ease-out infinite;
}

@keyframes micPulse {
  0% { transform: scale(0.92); opacity: 0.9; }
  100% { transform: scale(1.35); opacity: 0; }
}

.voice-holding {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--primary);
}

.voice-holding--processing { color: var(--text-muted); }

.voice-holding__wave { display: flex; align-items: center; gap: 6rpx; height: 30rpx; }
.voice-holding__wave text { display: block; width: 5rpx; border-radius: 5rpx; background: var(--primary); animation: micWave .8s ease-in-out infinite alternate; }
.voice-holding__wave text:nth-child(1) { height: 12rpx; }
.voice-holding__wave text:nth-child(2) { height: 28rpx; animation-delay: .15s; }
.voice-holding__wave text:nth-child(3) { height: 20rpx; animation-delay: .3s; }
.voice-holding__wave text:nth-child(4) { height: 10rpx; animation-delay: .45s; }

@keyframes micWave { from { transform: scaleY(.5); } to { transform: scaleY(1); } }

.voice-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--danger);
}

.voice-error__retry {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid currentColor;
}

.composer__ph {
  color: #b6c0cd;
}

.composer__send {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 2rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #d5dce5;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

.composer__send.ready {
  background: var(--primary);
}

.composer__send.ready:active {
  background: var(--primary-dark);
}

.composer__tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 20rpx;
  color: #a8b3c1;
}