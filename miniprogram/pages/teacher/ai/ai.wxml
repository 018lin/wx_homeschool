<view class="chat-page">
  <!-- 顶部操作栏 -->
  <view class="chat-topbar">
    <view class="chat-topbar__hint">结合本班作业、点评与观察记录作答</view>
    <view class="chat-topbar__actions">
      <view class="chat-topbar__btn" bindtap="goReport">看板</view>
      <view class="chat-topbar__btn" wx:if="{{!isAdmin}}" bindtap="goDaily">观察</view>
      <view class="chat-topbar__btn" bindtap="onNewChat">新会话</view>
    </view>
  </view>

  <!-- 对话区 -->
  <scroll-view
    class="chat-scroll"
    scroll-y
    scroll-with-animation
    scroll-into-view="{{anchorId}}"
  >
    <view class="chat-body">
      <!-- 空白态：中央主标题 -->
      <view class="chat-hero" wx:if="{{!messages.length}}">
        <view class="chat-hero__mark">AI</view>
        <view class="chat-hero__title">您想知道什么？请讲</view>
        <view class="chat-hero__sub">问我本班的作业提交、教师点评或校园观察，我会结合数据给出建议</view>
        <view class="chat-suggests">
          <view
            class="chat-suggest"
            wx:for="{{suggests}}"
            wx:key="*this"
            data-q="{{item}}"
            bindtap="onPickSuggest"
          >{{item}}</view>
        </view>
      </view>

      <!-- 消息 -->
      <view class="msg {{item.role}}" wx:for="{{messages}}" wx:key="key">
        <view class="msg__avatar" wx:if="{{item.role === 'assistant'}}">AI</view>
        <view class="msg__col">
          <view class="msg__bubble">
            <view wx:if="{{item.content}}" class="msg__text" user-select="{{true}}">{{item.content}}</view>
            <view class="msg__typing" wx:elif="{{item.role === 'assistant'}}">
              <view class="msg__dot"></view>
              <view class="msg__dot"></view>
              <view class="msg__dot"></view>
            </view>
          </view>
          <view class="msg__foot" wx:if="{{item.role === 'assistant' && item.content}}">
            <text class="msg__link" catchtap="onCopy" data-key="{{item.key}}">复制</text>
            <text class="msg__link" wx:if="{{item.error}}" catchtap="onRetry" data-key="{{item.key}}">重新回答</text>
          </view>
          <view class="msg__meta" wx:if="{{item.sources.length}}">
            参考：<text wx:for="{{item.sources}}" wx:for-item="s" wx:key="title">{{s.title}} </text>
          </view>
          <view class="msg__meta" wx:if="{{item.provider}}">{{item.provider}}</view>
          <view class="msg__error" wx:if="{{item.error}}">{{item.error}}</view>
        </view>
      </view>

      <!-- 滚动锚点：交替赋值以持续触发 scroll-into-view -->
      <view id="tail-a" class="chat-tail"></view>
      <view id="tail-b" class="chat-tail"></view>
    </view>
  </scroll-view>

  <!-- 底部输入区：支持长按语音输入 -->
  <view class="composer">
    <view class="composer__box">
      <view
        class="composer__mic {{voiceRecording ? 'active' : ''}} {{voiceTranscribing ? 'busy' : ''}}"
        bindtouchstart="onVoicePressStart"
        bindtouchend="onVoicePressEnd"
        bindtouchcancel="onVoicePressCancel"
        catchtap="noop"
        hover-class="none"
      >
        <view class="composer__mic-icon">
          <view class="composer__mic-head"></view>
          <view class="composer__mic-stem"></view>
          <view class="composer__mic-base"></view>
        </view>
        <view wx:if="{{voiceRecording}}" class="composer__mic-ring"></view>
      </view>
      <textarea
        class="composer__input"
        placeholder="您想知道什么？请讲"
        placeholder-class="composer__ph"
        value="{{draft}}"
        maxlength="1200"
        auto-height
        confirm-type="send"
        cursor-spacing="24"
        disable-default-padding="{{true}}"
        bindinput="onInput"
        bindconfirm="send"
      />
      <view class="composer__send {{canSend && !asking ? 'ready' : ''}}" bindtap="send">↑</view>
    </view>
    <view wx:if="{{voiceRecording}}" class="voice-holding">
      <view class="voice-holding__wave"><text></text><text></text><text></text><text></text></view>
      <text>正在聆听 · {{voiceSeconds}} 秒，松开发送</text>
    </view>
    <view wx:elif="{{voiceTranscribing}}" class="voice-holding voice-holding--processing">
      <text>正在把语音转成文字…</text>
    </view>
    <view wx:elif="{{voiceError}}" class="voice-error" bindtap="onVoiceErrorTap">
      <text>{{voiceError}}</text><text class="voice-error__retry">重试</text>
    </view>
    <view wx:else class="composer__tip">{{voiceHint}} · AI 生成内容仅供参考</view>
  </view>
</view>

<nav-bar role="{{isAdmin ? 'admin' : 'teacher'}}" active="{{isAdmin ? 'ai' : 'workbench'}}" />