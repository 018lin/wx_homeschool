.ov-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.ov-head__title {
  font-size: 36rpx;
  font-weight: 700;
}

.ov-head__sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.sg-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
}

.ov-insight {
  font-size: 26rpx;
  color: #536174;
  line-height: 1.9;
}

.ov-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ov-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.ov-bar__label {
  width: 140rpx;
  font-size: 24rpx;
  color: #536174;
  flex-shrink: 0;
}

.ov-bar__track {
  flex: 1;
  height: 20rpx;
  background: #eef2f7;
  border-radius: 999rpx;
  overflow: hidden;
}

.ov-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, #0057b8, #0f766e);
  border-radius: 999rpx;
}

.ov-bar__count {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  color: #8795a7;
}

.text-right {
  text-align: right;
}

.reminder-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 2rpx solid #f1f5f9; }
.mini-action { margin: 0; min-width: 150rpx; height: 64rpx; line-height: 64rpx; border: 2rpx solid #0057b8; border-radius: 999rpx; background: #fff; color: #0057b8; font-size: 23rpx; }
.reminder-editor { margin-top: 20rpx; }
.field__textarea--sm { min-height: 160rpx; }
.reminder-actions { display: flex; gap: 14rpx; margin-top: 14rpx; }
.reminder-actions .btn { flex: 1; }
