.ov-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.ov-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.ov-head__sub {
  font-size: var(--fs-base);
  opacity: 0.85;
  margin-top: 6rpx;
}

.sg-title {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
  line-height: 1.5;
}

.ov-insight {
  font-size: var(--fs-md);
  color: var(--text-sub);
  line-height: 1.9;
}

.ov-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ov-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.ov-bar__label {
  width: 140rpx;
  font-size: var(--fs-base);
  color: var(--text-sub);
  flex-shrink: 0;
}

.ov-bar__track {
  flex: 1;
  height: 20rpx;
  background: var(--fill-gray);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.ov-bar__fill {
  height: 100%;
  background: var(--grad-primary);
  border-radius: var(--radius-pill);
}

.ov-bar__count {
  width: 60rpx;
  text-align: right;
  font-size: var(--fs-base);
  color: var(--text-muted);
}

.text-right {
  text-align: right;
}

.reminder-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 2rpx solid var(--fill-dark); }
.mini-action { margin: 0; min-width: 150rpx; height: 64rpx; line-height: 64rpx; border: 2rpx solid var(--primary); border-radius: var(--radius-pill); background: var(--white); color: var(--primary); font-size: var(--fs-sm); }
.reminder-editor { margin-top: 20rpx; }
.reminder-actions { display: flex; gap: 14rpx; margin-top: 14rpx; }
.reminder-actions .btn { flex: 1; }

/* .field__textarea--sm 统一到 app.wxss（min-height: 140rpx，原为 160rpx） */
