.wb-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.wb-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.wb-head__sub {
  font-size: var(--fs-base);
  opacity: 0.85;
  margin-top: 6rpx;
}

.task-title {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
  line-height: 1.5;
}

.task-meta {
  margin-top: 12rpx;
}

/* 今日校园观察：白蓝主色调，与小程序主题（--primary / --bg）保持一致 */
.daily-feature {
  min-height: 520rpx;
  margin-bottom: 28rpx;
  padding: 34rpx 34rpx 32rpx;
  border: 2rpx solid #d6e5fb;
  border-radius: var(--radius-xl);
  background: linear-gradient(180deg, #ffffff 0%, #f2f8ff 100%);
  box-shadow: var(--shadow-xs);
  box-sizing: border-box;
  overflow: hidden;
}

.daily-feature__eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-light);
  color: var(--primary);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  letter-spacing: 1rpx;
}

.daily-feature__body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  min-height: 426rpx;
  margin-top: 18rpx;
}

.daily-feature__copy {
  width: 100%;
  text-align: center;
}

.daily-feature__title {
  color: var(--text);
  font-size: 44rpx;
  font-weight: var(--fw-semibold);
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.daily-feature__desc {
  color: var(--text-sub);
  font-size: var(--fs-base);
  line-height: 1.6;
  text-align: center;
}

.daily-feature__hint {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--fs-sm);
  line-height: 1.5;
  text-align: center;
}

.daily-feature__record {
  flex-shrink: 0;
  width: 206rpx;
  margin: 22rpx 0 18rpx;
  text-align: center;
}

.daily-feature__mic-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  background: var(--grad-primary-deep);
  box-shadow: 0 0 0 14rpx rgba(0, 87, 184, 0.12);
}

.daily-feature__mic-button::after {
  content: "";
  position: absolute;
  inset: 14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 50%;
}

.daily-feature__mic {
  position: relative;
  width: 58rpx;
  height: 76rpx;
  z-index: 1;
}

.daily-feature__footer {
  width: 100%;
}

.daily-feature__mic-head {
  position: absolute;
  top: 0;
  left: 13rpx;
  width: 32rpx;
  height: 48rpx;
  border: 5rpx solid var(--white);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.daily-feature__mic-cage {
  position: absolute;
  top: 22rpx;
  left: 7rpx;
  width: 44rpx;
  height: 38rpx;
  border: 5rpx solid var(--white);
  border-top: 0;
  border-radius: 0 0 28rpx 28rpx;
  box-sizing: border-box;
}

.daily-feature__mic-stem {
  position: absolute;
  left: 26rpx;
  bottom: 4rpx;
  width: 6rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: var(--white);
}

.daily-feature__mic-base {
  position: absolute;
  left: 11rpx;
  bottom: 0;
  width: 36rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: var(--white);
}

.daily-feature__action {
  margin-top: 24rpx;
  color: var(--primary);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
}
