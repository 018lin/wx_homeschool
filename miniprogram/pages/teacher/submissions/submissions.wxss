.sm-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.sm-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.sm-head__sub {
  font-size: var(--fs-base);
  opacity: 0.85;
  margin-top: 6rpx;
}

.sm-item__name {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
}

.ml {
  margin-left: 12rpx;
}

.sm-item__title {
  font-size: var(--fs-md);
  color: var(--primary);
  margin-top: 8rpx;
}

.sm-item__content {
  font-size: var(--fs-md);
  color: var(--text-sub);
  line-height: 1.7;
  margin-top: 10rpx;
  white-space: pre-wrap;
}

.sm-item__foot {
  display: flex;
  justify-content: space-between;
  font-size: var(--fs-sm);
  color: var(--text-muted);
  margin-top: 16rpx;
}
