.sg-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.sg-head__name {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.sg-head__meta {
  font-size: var(--fs-base);
  opacity: 0.9;
  margin-top: 6rpx;
}

.sg-head__sub {
  display: inline-block;
  margin-top: 14rpx;
  padding: 4rpx 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.2);
  font-size: var(--fs-sm);
}

.ts-row {
  display: flex;
  font-size: var(--fs-md);
  margin-top: 8rpx;
}

.ts-row__label {
  color: var(--text-muted);
  width: 120rpx;
  flex-shrink: 0;
}

.ts-row__value {
  color: var(--text-sub);
  flex: 1;
}

.ts-note {
  margin-top: 16rpx;
  background: var(--fill);
  border-radius: var(--radius-sm);
  padding: 16rpx;
  font-size: var(--fs-md);
  color: var(--text-sub);
  line-height: 1.7;
}

.sg-title {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
  line-height: 1.5;
}

/* AI 建议卡片顶部：徽标 + 重新生成入口 */
.sg-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sg-card-top__left {
  display: flex;
  align-items: center;
  gap: var(--sp-sm);
}

.sg-regen {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-light);
  flex-shrink: 0;
}

.sg-regen__icon {
  font-size: var(--fs-lg);
  line-height: 1;
  color: var(--primary);
}

.sg-regen__text {
  font-size: var(--fs-base);
  color: var(--primary);
}

.sg-regen:active {
  opacity: 0.7;
}

/* 本次重新生成所依据的教师描述 */
.sg-note {
  display: flex;
  margin-bottom: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-sm);
  background: var(--teal-light);
}

.sg-note__label {
  font-size: var(--fs-sm);
  color: var(--teal);
  flex-shrink: 0;
  margin-right: var(--sp-sm);
}

.sg-note__text {
  font-size: var(--fs-base);
  color: var(--text-sub);
  line-height: 1.7;
  flex: 1;
}

.sg-block {
  margin-top: 20rpx;
}

.sg-block__label {
  font-size: var(--fs-md);
  font-weight: var(--fw-semibold);
  color: var(--primary);
  margin-bottom: 8rpx;
}

.sg-block__body {
  font-size: var(--fs-md);
  color: var(--text-body);
  line-height: 1.75;
  background: var(--fill);
  border-radius: var(--radius-sm);
  padding: 18rpx;
  white-space: pre-wrap;
}

.sg-block__body--teal {
  background: var(--teal-light);
}

.sg-rationale {
  margin-top: 20rpx;
  font-size: var(--fs-base);
  color: var(--text-muted);
  line-height: 1.7;
  border-left: 4rpx solid var(--line);
  padding-left: 16rpx;
}

/* 重新生成弹窗 */
.rg-tip {
  font-size: var(--fs-base);
  color: var(--text-sub);
  line-height: 1.7;
  padding: 20rpx 0;
}

.rg-count {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  text-align: right;
  padding-top: 12rpx;
}
