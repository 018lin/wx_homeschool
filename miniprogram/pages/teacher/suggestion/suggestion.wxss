.sg-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.sg-head__name {
  font-size: 38rpx;
  font-weight: 700;
}

.sg-head__meta {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.sg-head__sub {
  display: inline-block;
  margin-top: 14rpx;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
}

.ts-row {
  display: flex;
  font-size: 25rpx;
  margin-top: 8rpx;
}

.ts-row__label {
  color: #8795a7;
  width: 120rpx;
  flex-shrink: 0;
}

.ts-row__value {
  color: #536174;
  flex: 1;
}

.ts-note {
  margin-top: 16rpx;
  background: #f8fbff;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 25rpx;
  color: #536174;
  line-height: 1.7;
}

.sg-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
}

.sg-block {
  margin-top: 20rpx;
}

.sg-block__label {
  font-size: 25rpx;
  font-weight: 600;
  color: #0057b8;
  margin-bottom: 8rpx;
}

.sg-block__body {
  font-size: 27rpx;
  color: #374151;
  line-height: 1.75;
  background: #f8fbff;
  border-radius: 12rpx;
  padding: 18rpx;
  white-space: pre-wrap;
}

.sg-block__body--teal {
  background: #e9f8f0;
}

.sg-rationale {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8795a7;
  line-height: 1.7;
  border-left: 4rpx solid #e1e8f0;
  padding-left: 16rpx;
}
