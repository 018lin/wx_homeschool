<app-header title="任务建议" sub="" mode="back" variant="hero" />
<view class="page page-with-nav page--hero">
  <view class="loading-wrap" wx:if="{{loading}}">加载中…</view>

  <block wx:if="{{!loading && student}}">
    <view class="sg-head">
      <view class="sg-head__name">{{student.name}}</view>
      <view class="sg-head__meta">
        {{student.grade}}<text wx:if="{{student.gender}}"> · {{student.gender}}</text>
        <text wx:if="{{student.age}}"> · {{student.age}} 岁</text>
      </view>
      <view class="sg-head__sub" wx:if="{{aiMeta}}">{{aiMeta.status}}</view>
    </view>

    <view class="card">
      <view class="card-title"><text class="card-title__text">家庭情况</text></view>
      <view class="ts-row" wx:if="{{student.caregiver}}">
        <text class="ts-row__label">陪伴人</text>
        <text class="ts-row__value">{{student.caregiver}}</text>
      </view>
      <view class="ts-row" wx:if="{{student.timeAvailable}}">
        <text class="ts-row__label">可陪伴</text>
        <text class="ts-row__value">{{student.timeAvailable}}</text>
      </view>
      <view class="ts-row" wx:if="{{student.taskPreference}}">
        <text class="ts-row__label">任务偏好</text>
        <text class="ts-row__value">{{student.taskPreference}}</text>
      </view>
      <view class="mt-12" wx:if="{{student.interests.length}}">
        <text class="tag" wx:for="{{student.interests}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="ts-note" wx:if="{{student.familyNote}}">{{student.familyNote}}</view>
    </view>

    <view class="card" wx:if="{{history}}">
      <view class="stat-grid">
        <view class="stat">
          <view class="stat__value">{{history.totalCompleted || 0}}</view>
          <view class="stat__label">累计完成</view>
        </view>
        <view class="stat">
          <view class="stat__value">{{history.completedTypes.length || 0}}</view>
          <view class="stat__label">涉及类型</view>
        </view>
      </view>
    </view>

    <view class="section-title">AI 任务建议</view>

    <view class="card" wx:for="{{suggestions}}" wx:key="title">
      <view class="sg-card-top">
        <view class="sg-card-top__left">
          <text class="badge {{item.aiGenerated ? 'badge-teal' : 'badge-gray'}}">
            {{item.aiGenerated ? 'AI 建议' : 'AI 整理中'}}
          </text>
          <text class="text-sm text-muted">{{item.duration}} 分钟 · {{item.type}}</text>
        </view>
        <view class="sg-regen" bindtap="openRegenModal">
          <text class="sg-regen__icon">↻</text>
          <text class="sg-regen__text">重新生成</text>
        </view>
      </view>

      <view class="sg-note" wx:if="{{regenNote}}">
        <text class="sg-note__label">本次依据</text>
        <text class="sg-note__text">{{regenNote}}</text>
      </view>

      <view class="sg-title">{{item.title}}</view>

      <view class="sg-block" wx:if="{{item.goal}}">
        <view class="sg-block__label">目标</view>
        <view class="sg-block__body">{{item.goal}}</view>
      </view>
      <view class="sg-block" wx:if="{{item.steps}}">
        <view class="sg-block__label">步骤</view>
        <view class="sg-block__body">{{item.steps}}</view>
      </view>
      <view class="sg-block" wx:if="{{item.dialogueTips}}">
        <view class="sg-block__label">话术</view>
        <view class="sg-block__body sg-block__body--teal">{{item.dialogueTips}}</view>
      </view>
      <view class="sg-block" wx:if="{{item.submitHint}}">
        <view class="sg-block__label">提交</view>
        <view class="sg-block__body">{{item.submitHint}}</view>
      </view>
      <view class="sg-rationale" wx:if="{{item.rationale}}">{{item.rationale}}</view>

      <button class="btn btn-outline btn-block mt-24" data-index="{{index}}" bindtap="useSuggestion">
        按此建议发布任务
      </button>
    </view>
  </block>
</view>

<!-- 重新生成：先由教师口述学生情况，再交 AI 整理并重出任务 -->
<view class="modal-mask" wx:if="{{regenVisible}}" catchtap="closeRegenModal" catchtouchmove="noop">
  <view class="modal-sheet" catchtap="noop">
    <view class="modal-head">
      <text class="modal-head__title">补充学生情况</text>
      <text class="modal-head__close" bindtap="closeRegenModal">取消</text>
    </view>

    <view class="modal-body">
      <view class="rg-tip">用一两句话说清这次要解决的问题，例如近期状态、困难点、能配合的时间和可用材料。AI 会先整理这段描述，再结合档案重新生成任务。</view>
      <textarea
        class="field__textarea"
        value="{{regenDraft}}"
        bindinput="onRegenInput"
        placeholder="例如：小宇最近不太愿意主动开口讲学校的事，晚上作业会拖延到十点，只有妈妈能陪，基本没什么教具。"
        placeholder-class="ph"
        maxlength="800"
        cursor-spacing="24"
      />
      <view class="rg-count">{{regenDraft.length}} / 800</view>
    </view>

    <view class="modal-foot">
      <button class="btn btn-primary btn-block" bindtap="confirmRegen" loading="{{regenerating}}" disabled="{{regenerating || !regenDraft.trim()}}">
        {{regenerating ? 'AI 整理生成中…' : '确认并重新生成'}}
      </button>
    </view>
  </view>
</view>

<nav-bar role="teacher" active="students" />
