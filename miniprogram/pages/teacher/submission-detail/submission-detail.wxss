.sd-name {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
}

.ml {
  margin-left: 12rpx;
}

.sd-task-title {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  color: var(--primary);
  line-height: 1.5;
}

.task-meta {
  margin-top: 12rpx;
}

.sd-content {
  font-size: var(--fs-lg);
  color: var(--text-body);
  line-height: 1.8;
  background: var(--fill);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  white-space: pre-wrap;
}

.sd-imgs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.sd-imgs__pic {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  margin: 0 16rpx 16rpx 0;
}

.sd-fb {
  background: var(--teal-light);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.sd-fb:last-child {
  margin-bottom: 0;
}

.sd-fb__teacher {
  font-size: var(--fs-base);
  color: var(--teal);
  font-weight: var(--fw-semibold);
}

.sd-fb__text {
  font-size: var(--fs-md);
  color: var(--text);
  line-height: 1.7;
  white-space: pre-wrap;
}

.ph {
  color: var(--text-placeholder);
}
.sd-media { margin-top: 16rpx; }
.sd-audio { margin-bottom: 12rpx; padding: 18rpx; border-radius: var(--radius-sm); color: var(--primary); background: var(--primary-lighter); font-size: var(--fs-base); }
.sd-video { width: 100%; height: 340rpx; margin-bottom: 12rpx; border-radius: var(--radius-sm); background: var(--text); }
