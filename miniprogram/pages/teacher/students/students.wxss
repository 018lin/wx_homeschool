.ts-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.ts-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.ts-head__sub {
  font-size: var(--fs-base);
  opacity: 0.85;
  margin-top: 6rpx;
}

.search-box {
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 12rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-xs);
}

.search-box__input {
  font-size: var(--fs-lg);
  height: 64rpx;
  color: var(--text);
}

.ph {
  color: var(--text-placeholder);
}

.ts-name {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
}

.ml {
  margin-left: 12rpx;
}

.ts-row {
  display: flex;
  font-size: var(--fs-md);
  margin-top: 8rpx;
}

.ts-row__label {
  color: var(--text-muted);
  width: 120rpx;
  flex-shrink: 0;
}

.ts-row__value {
  color: var(--text-sub);
  flex: 1;
}

.ts-note {
  margin-top: 16rpx;
  background: var(--fill);
  border-radius: var(--radius-sm);
  padding: 16rpx;
  font-size: var(--fs-md);
  color: var(--text-sub);
  line-height: 1.7;
}
