.gd-intro {
  padding: 56rpx 24rpx 48rpx;
  text-align: center;
}

.gd-intro__icon {
  font-size: 72rpx;
  line-height: 1;
}

.gd-intro__title {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
  margin-top: 20rpx;
}

.gd-intro__hint {
  font-size: var(--fs-md);
  color: var(--text-muted);
  line-height: 1.7;
  margin-top: 12rpx;
}
