.garden-editor {
  margin-bottom: 32rpx;
}

.garden-count {
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.garden-textarea {
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--fill);
  color: var(--text);
  font-size: var(--fs-lg);
  line-height: 1.7;
}

.garden-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.garden-image {
  position: relative;
  min-width: 0;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: var(--radius-sm);
  background: var(--fill-dark);
}

.garden-image__preview {
  width: 100%;
  height: 100%;
  display: block;
}

.garden-image__remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--text-sub);
  color: var(--white);
  font-size: 30rpx;
  line-height: 38rpx;
  text-align: center;
}

.garden-image--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--text-placeholder);
  background: var(--fill);
  color: var(--primary);
}

.garden-image__plus {
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.garden-image__label {
  margin-top: 10rpx;
  font-size: var(--fs-sm);
}

.garden-upload {
  margin-top: 16rpx;
  color: var(--warning);
  font-size: var(--fs-sm);
}

.garden-save {
  margin-top: 24rpx;
}
