.wr-head {
  margin-bottom: 24rpx;
}

.wr-head__title {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
  color: var(--text);
}

.wr-head__sub {
  font-size: var(--fs-md);
  color: var(--text-muted);
  margin-top: 8rpx;
}

.wr-textarea {
  width: 100%;
  min-height: 260rpx;
  box-sizing: border-box;
  background: var(--fill);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: var(--fs-lg);
  line-height: 1.7;
  color: var(--text);
}

.wr-counter {
  text-align: right;
  font-size: var(--fs-base);
  color: var(--text-muted);
  margin-top: 12rpx;
}

.wr-counter--full {
  color: var(--danger);
}

.wr-sent {
  padding: 40rpx 24rpx 32rpx;
  text-align: center;
}

.wr-sent__icon {
  font-size: 64rpx;
  line-height: 1;
}

.wr-sent__title {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  color: var(--success);
  margin-top: 16rpx;
}

.wr-sent__hint {
  font-size: var(--fs-md);
  color: var(--text-muted);
  line-height: 1.7;
  margin-top: 8rpx;
}

/* ---------- 已提交的心事与回复 ---------- */
.wr-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.wr-item:last-child {
  border-bottom: none;
}

.wr-item__content {
  font-size: var(--fs-lg);
  color: var(--text-body);
  line-height: 1.7;
  margin-top: 12rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.wr-item__reply {
  margin-top: 16rpx;
  background: var(--teal-light);
  border-radius: 0 14rpx 14rpx 0;
  border-left: 6rpx solid var(--teal);
  padding: 18rpx 20rpx;
}

.wr-item__reply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--fs-base);
  color: var(--teal);
  font-weight: var(--fw-semibold);
}

.wr-item__reply-time {
  font-size: var(--fs-sm);
  color: var(--text-muted);
  font-weight: var(--fw-normal);
}

.wr-item__reply-text {
  font-size: var(--fs-md);
  color: var(--text);
  line-height: 1.7;
  margin-top: 10rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.wr-item__pending {
  font-size: var(--fs-base);
  color: var(--text-muted);
  margin-top: 14rpx;
}

.wr-empty {
  padding: 60rpx 20rpx 40rpx;
  text-align: center;
}

.wr-empty__text {
  font-size: var(--fs-lg);
  color: var(--text-muted);
}

.wr-empty__hint {
  font-size: var(--fs-base);
  color: var(--text-muted);
  margin-top: 12rpx;
}

.ph {
  color: var(--text-placeholder);
}