.st-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 36rpx 28rpx;
  color: var(--white);
  margin-bottom: 24rpx;
}

.st-head__hello {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.st-head__sub {
  font-size: var(--fs-base);
  opacity: 0.9;
  margin-top: 6rpx;
}

.task-title {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-bold);
  color: var(--text);
  line-height: 1.5;
}

.task-meta {
  margin-top: 12rpx;
}

.task-block {
  margin-top: 24rpx;
}

.task-block__label {
  font-size: var(--fs-md);
  font-weight: var(--fw-semibold);
  color: var(--primary);
  margin-bottom: 10rpx;
}

.task-block__body {
  font-size: var(--fs-lg);
  color: var(--text-body);
  line-height: 1.75;
  white-space: pre-wrap;
  background: var(--fill);
  border-radius: var(--radius-sm);
  padding: 20rpx;
}

.feedback-comment {
  font-size: var(--fs-lg);
  color: var(--text);
  line-height: 1.7;
  background: var(--teal-light);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  white-space: pre-wrap;
}

.st-locked {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--fs-md);
  color: var(--success);
  background: var(--teal-light);
  border-radius: var(--radius-sm);
  padding: 20rpx;
}

/* ---------- 学习园地入口 ---------- */
.gd-entry {
  display: flex;
  align-items: center;
}

.gd-entry__title {
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  color: var(--text);
}

.gd-entry__arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--fs-3xl);
  color: var(--text-muted);
}

/* ---------- 右下角悬浮按钮：我的小心事 ---------- */
.st-fab {
  position: fixed;
  right: 36rpx;
  /* 避开底部导航条与安全区 */
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--grad-primary);
  box-shadow: 0 8rpx 24rpx rgba(0, 87, 184, .32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
}

.st-fab:active {
  opacity: .85;
  transform: scale(.94);
}

.st-fab__plus {
  font-size: 60rpx;
  line-height: 1;
  color: var(--white);
  font-weight: 300;
  margin-top: -6rpx;
}
