.st-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.st-head__hello {
  font-size: 38rpx;
  font-weight: 700;
}

.st-head__sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.task-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.5;
}

.task-meta {
  margin-top: 12rpx;
}

.task-block {
  margin-top: 24rpx;
}

.task-block__label {
  font-size: 26rpx;
  font-weight: 600;
  color: #0057b8;
  margin-bottom: 10rpx;
}

.task-block__body {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.75;
  white-space: pre-wrap;
  background: #f8fbff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.feedback-comment {
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.7;
  background: #e9f8f0;
  border-radius: 12rpx;
  padding: 20rpx;
  white-space: pre-wrap;
}

.st-locked {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #157a45;
  background: #e9f8f0;
  border-radius: 12rpx;
  padding: 20rpx;
}

/* ---------- 学习园地入口 ---------- */
.gd-entry {
  display: flex;
  align-items: center;
}

.gd-entry__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.gd-entry__arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 36rpx;
  color: var(--text-muted);
}

/* ---------- 右下角悬浮按钮：我的小心事 ---------- */
.st-fab {
  position: fixed;
  right: 36rpx;
  /* 避开底部导航条与安全区 */
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 87, 184, .32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
}

.st-fab:active {
  opacity: .85;
  transform: scale(.94);
}

.st-fab__plus {
  font-size: 60rpx;
  line-height: 1;
  color: #fff;
  font-weight: 300;
  margin-top: -6rpx;
}
