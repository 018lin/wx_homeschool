.gd-intro {
  margin-bottom: var(--sp-lg);
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background: var(--primary-lighter);
  border: 2rpx solid var(--line-soft);
}

.gd-intro__title {
  color: var(--text);
  font-size: var(--fs-2xl);
  font-weight: var(--fw-bold);
}

.gd-intro__hint {
  margin-top: 8rpx;
  color: var(--text-sub);
  font-size: var(--fs-md);
  line-height: 1.65;
}

.gd-intro__meta {
  margin-top: 16rpx;
  color: var(--primary);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
}

/* ---------- 动态卡片：微信朋友圈式排布 ---------- */
.gd-post {
  margin-bottom: 20rpx;
}

.gd-post__head {
  display: flex;
  align-items: center;
}

.gd-post__avatar {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: 14rpx;
  background: var(--fill-dark);
}

.gd-post__who {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.gd-post__name {
  color: #4a5b76;
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  line-height: 1.3;
}

.gd-post__grade {
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.gd-post__delete {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--fill-dark);
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.gd-post__content {
  margin-top: 18rpx;
  color: var(--text);
  font-size: var(--fs-lg);
  line-height: 1.72;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 图片排布与微信朋友圈一致：1 张大图、2/4 张两列（单格与三列同尺寸）、其余三列 */
.gd-post__images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.gd-post__images--two {
  width: 66.6%;
  grid-template-columns: repeat(2, 1fr);
}

.gd-post__images--one {
  width: 58%;
  grid-template-columns: 1fr;
}

.gd-post__image {
  width: 100%;
  aspect-ratio: 1;
  display: block;
  border-radius: var(--radius-sm);
  background: var(--fill-dark);
}

.gd-post__foot {
  margin-top: 16rpx;
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

/* ---------- 右下角悬浮按钮：发布学习成果（与首页保持一致） ---------- */
.st-fab {
  position: fixed;
  right: 36rpx;
  /* 避开底部导航条与安全区 */
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--grad-primary);
  box-shadow: 0 8rpx 24rpx rgba(0, 87, 184, .32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
}

.st-fab:active {
  opacity: .85;
  transform: scale(.94);
}

.st-fab__plus {
  font-size: 60rpx;
  line-height: 1;
  color: var(--white);
  font-weight: 300;
  margin-top: -6rpx;
}
