/* 聊天页（微信风格）：气泡 + 底部固定输入栏 */
page { height: 100%; }
.chat-page { display: flex; flex-direction: column; height: 100vh; background: var(--bg); box-sizing: border-box; }

/* 消息区 */
.chat-list { flex: 1; min-height: 0; }
.chat-list__inner { padding: 24rpx 24rpx 40rpx; }
.chat-tip, .chat-empty { text-align: center; color: var(--text-muted); font-size: var(--fs-base); padding: 60rpx 0; }

.msg { display: flex; align-items: flex-start; margin-bottom: 28rpx; }
.msg--theirs { justify-content: flex-start; }
.msg--mine { justify-content: flex-end; }

.msg__avatar { width: 76rpx; height: 76rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-xl); font-weight: var(--fw-semibold); flex-shrink: 0; background: var(--fill-gray); color: var(--white); overflow: hidden; }
.msg__avatar--me { background: var(--primary); }
/* 默认头像图为浅色底图，配深色首字母 */
.msg__avatar text { color: #4a5b70; }
/* 真实头像铺满头像容器；加载失败时由 binderror 回落首字母 */
.msg__avatar__img { width: 100%; height: 100%; border-radius: 50%; display: block; background: var(--white); }

.msg__col { max-width: 66%; min-width: 0; flex-shrink: 1; margin: 0 18rpx; display: flex; flex-direction: column; }
.msg--theirs .msg__col { align-items: flex-start; }
.msg--mine .msg__col { align-items: flex-end; }

.msg__bubble { padding: 18rpx 22rpx; border-radius: var(--radius-lg); background: var(--white); color: var(--text); font-size: var(--fs-lg); line-height: 1.55; white-space: pre-wrap; word-break: break-all; box-shadow: 0 2rpx 8rpx rgba(15, 40, 80, .06); }
.msg--theirs .msg__bubble { border-top-left-radius: 6rpx; }
.msg--mine .msg__bubble { background: var(--primary); color: var(--white); border-top-right-radius: 6rpx; }

.msg__time { margin-top: 8rpx; color: var(--text-muted); font-size: var(--fs-xs); }

/* 底部输入栏 */
.chat-composer { display: flex; align-items: flex-end; gap: 14rpx; padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--white); border-top: 2rpx solid var(--line); }
.chat-composer__input { flex: 5 1 0; width: 100%; min-height: 72rpx; max-height: 220rpx; padding: 16rpx 20rpx; background: #f2f5f9; border-radius: var(--radius-md); font-size: var(--fs-lg); line-height: 1.4; box-sizing: border-box; }
.chat-composer__send { flex: 1 1 0; height: 72rpx; margin: 0; padding: 0; line-height: 72rpx; border-radius: var(--radius-md); background: var(--primary); color: var(--white); font-size: var(--fs-md); }
.chat-composer__send[disabled] { opacity: .45; }
