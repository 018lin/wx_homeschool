<view class="page page-with-nav message-page">
  <view class="msg-search">
    <view class="msg-search__box">
      <input class="msg-search__input" placeholder="搜索姓名或账号" placeholder-class="ph" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
      <view class="msg-search__clear" wx:if="{{keyword}}" bindtap="clearSearch">×</view>
    </view>
  </view>
  <view class="msg-list">
    <view class="msg-item" wx:for="{{filteredContacts}}" wx:key="id" data-id="{{item.id}}" bindtap="openPeer" hover-class="msg-item--hover">
      <view class="msg-item__avatar role-{{item.role}}">{{item.initial}}</view>
      <view class="msg-item__main">
        <view class="msg-item__top">
          <view class="msg-item__name">{{item.name}}</view>
          <view class="msg-item__time" wx:if="{{item.lastAtText}}">{{item.lastAtText}}</view>
        </view>
        <view class="msg-item__bottom">
          <view class="msg-item__preview">{{item.lastContent || item.roleLabel + ' · ' + item.account}}</view>
          <view class="msg-item__badge" wx:if="{{item.unreadCount}}">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</view>
        </view>
      </view>
    </view>
    <view class="msg-empty" wx:if="{{!filteredContacts.length && !loading}}">
      <view class="msg-empty__icon">✉</view>
      <view class="msg-empty__text">暂无可联系的用户</view>
    </view>
    <view class="msg-loading" wx:if="{{loading}}">加载中…</view>
  </view>
</view>
<nav-bar role="{{role}}" active="messages" />
