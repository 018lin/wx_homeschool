.mine-head {
  background: var(--grad-primary);
  border-radius: var(--radius-lg);
  padding: 48rpx 28rpx 36rpx;
  color: var(--white);
  text-align: center;
  margin-bottom: 24rpx;
}

.mine-head__avatar-box {
  position: relative;
  width: 120rpx;
  margin: 0 auto 20rpx;
}

.mine-head__avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--white);
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
}

.mine-head__avatar-wrap--hover {
  opacity: 0.85;
}

.mine-head__avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

/* 头像右下角「更换」提示 */
.mine-head__avatar-tip {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  transform: translateX(-50%);
  padding: 2rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: var(--white);
  font-size: var(--fs-xs);
  line-height: 1.6;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
}

/* 上传中遮罩 */
.mine-head__avatar-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: var(--white);
  font-size: var(--fs-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine-head__name {
  font-size: var(--fs-3xl);
  font-weight: var(--fw-bold);
}

.mine-head__account {
  font-size: var(--fs-base);
  opacity: 0.85;
  margin-top: 6rpx;
}

.mine-head__role {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 28rpx;
  border-radius: var(--radius-pill);
  background: var(--white);
  font-size: var(--fs-base);
  font-weight: var(--fw-semibold);
}

.mine-foot {
  text-align: center;
  color: var(--text-muted);
  font-size: var(--fs-base);
  padding: 48rpx 0 24rpx;
}

.mine-foot__sub {
  margin-top: 8rpx;
  opacity: 0.8;
}

/* 协议入口：可点击行 + 右侧箭头（.list-item 本身是基础类，这里只补交互反馈） */
.list-item--hover {
  opacity: 0.6;
}

.list-item__arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--fs-2xl);
  line-height: 1;
  color: var(--text-placeholder);
  align-self: center;
}

/* 修改密码：密码输入行 + 明文切换 */
.pwd-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pwd-row__input {
  flex: 1;
  min-width: 0;
}

.pwd-row__eye {
  flex-shrink: 0;
  padding: 0 8rpx;
  font-size: var(--fs-base);
  color: var(--primary);
}

.pwd-row__eye:active {
  opacity: 0.6;
}

.pwd-tip {
  margin-top: 10rpx;
  font-size: var(--fs-sm);
  color: var(--danger);
}
