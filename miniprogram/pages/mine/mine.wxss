.mine-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 48rpx 28rpx 36rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 24rpx;
}

.mine-head__avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
}

.mine-head__avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.mine-head__name {
  font-size: 36rpx;
  font-weight: 700;
}

.mine-head__account {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.mine-head__role {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.mine-foot {
  text-align: center;
  color: #8795a7;
  font-size: 24rpx;
  padding: 48rpx 0 24rpx;
}

.mine-foot__sub {
  margin-top: 8rpx;
  opacity: 0.8;
}
