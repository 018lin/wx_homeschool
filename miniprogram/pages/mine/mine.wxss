.mine-head {
  background: linear-gradient(135deg, #0057b8 0%, #0f766e 100%);
  border-radius: 20rpx;
  padding: 48rpx 28rpx 36rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 24rpx;
}

.mine-head__avatar-box {
  position: relative;
  width: 120rpx;
  margin: 0 auto 20rpx;
}

.mine-head__avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
}

.mine-head__avatar-wrap--hover {
  opacity: 0.85;
}

.mine-head__avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

/* 头像右下角「更换」提示 */
.mine-head__avatar-tip {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  transform: translateX(-50%);
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  line-height: 1.6;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
}

/* 上传中遮罩 */
.mine-head__avatar-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine-head__name {
  font-size: 36rpx;
  font-weight: 700;
}

.mine-head__account {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.mine-head__role {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.mine-foot {
  text-align: center;
  color: #8795a7;
  font-size: 24rpx;
  padding: 48rpx 0 24rpx;
}

.mine-foot__sub {
  margin-top: 8rpx;
  opacity: 0.8;
}
