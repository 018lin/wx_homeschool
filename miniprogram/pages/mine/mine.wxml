<app-header title="我的" sub="家校共育 · 让成长被看见" mode="home" variant="hero" />
<view class="page page-with-nav page--hero">
  <view class="mine-head">
    <view class="mine-head__avatar-box">
      <view class="mine-head__avatar-wrap" bindtap="onTapAvatar" hover-class="mine-head__avatar-wrap--hover">
        <image class="mine-head__avatar" src="{{avatarImage}}" mode="aspectFill" />
        <view class="mine-head__avatar-mask" wx:if="{{uploading}}">上传中</view>
      </view>
      <view class="mine-head__avatar-tip" wx:if="{{!uploading}}">更换</view>
    </view>
    <view class="mine-head__name">{{user.displayName || '未设置姓名'}}</view>
    <view class="mine-head__account">账号 {{user.account || '-'}}</view>
    <view class="mine-head__role" style="color:{{roleColor}}">{{roleLabel}}</view>
  </view>

  <view class="card">
    <view class="list-item">
      <view class="list-item__main">
        <view class="list-item__title">身份</view>
        <view class="list-item__desc">{{roleLabel}}账号，由学校统一创建</view>
      </view>
    </view>
    <view class="list-item" bindtap="onOpenAgreement" data-doc="user-agreement" hover-class="list-item--hover">
      <view class="list-item__main">
        <view class="list-item__title">用户协议</view>
        <view class="list-item__desc">服务条款与使用规范</view>
      </view>
      <view class="list-item__arrow">›</view>
    </view>
    <view class="list-item" bindtap="onOpenAgreement" data-doc="privacy-policy" hover-class="list-item--hover">
      <view class="list-item__main">
        <view class="list-item__title">隐私政策</view>
        <view class="list-item__desc">个人信息收集、使用与您的权利</view>
      </view>
      <view class="list-item__arrow">›</view>
    </view>
  </view>

  <button class="btn btn-danger btn-block" bindtap="onLogout">退出登录</button>

  <view class="mine-foot">
    <view>凌田家校 · 家校共育系统</view>
    <view class="mine-foot__sub">小程序版</view>
  </view>
</view>

<agreement-modal
  visible="{{agreementVisible}}"
  doc-type="{{agreementDoc}}"
  bind:close="onCloseAgreement"
  bind:confirm="onCloseAgreement"
/>

<nav-bar role="{{user.role}}" active="mine" />
