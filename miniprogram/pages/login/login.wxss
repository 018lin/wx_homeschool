/* ---------- 页面背景：天空蓝 → 淡蓝 → 草绿奶油色 ---------- */
/* page 底色与渐变首色保持一致：状态栏占位已移入 .login 内部，
   顶部不再出现浅色带；这里同色兜底可消除下拉回弹时的色差 */
page {
  background: #7cc3ee;
}

.login {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #7cc3ee 0%, #a9d9f4 28%, #d3ecf6 52%, #e6f4e4 76%, #f6f3da 100%);
  padding: 0 0 60rpx;
  box-sizing: border-box;
}

/* ---------- 背景装饰 ---------- */
.deco {
  position: absolute;
  pointer-events: none;
}

.deco-blob {
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.55;
}
.deco-blob--green {
  width: 360rpx;
  height: 360rpx;
  left: -120rpx;
  bottom: 200rpx;
  background: #bfe8a9;
}
.deco-blob--blue {
  width: 300rpx;
  height: 300rpx;
  right: -100rpx;
  top: 420rpx;
  background: #9fd4f5;
}

/* 树叶：旋转的水滴形 */
.deco-leaf {
  width: 90rpx;
  height: 90rpx;
  background: #a7d99a;
  border-radius: 0 100% 0 100%;
  opacity: 0.75;
}
.deco-leaf--tl {
  left: 24rpx;
  top: 320rpx;
  transform: rotate(-30deg);
}
.deco-leaf--r {
  right: 30rpx;
  top: 470rpx;
  width: 72rpx;
  height: 72rpx;
  background: #8fd08a;
  transform: rotate(140deg);
  opacity: 0.6;
}

/* 爱心 */
.deco-heart {
  width: 44rpx;
  height: 40rpx;
  opacity: 0.7;
}
.deco-heart::before,
.deco-heart::after {
  content: "";
  position: absolute;
  top: 0;
  width: 22rpx;
  height: 34rpx;
  border-radius: 22rpx 22rpx 0 0;
  background: #f7a8b8;
}
.deco-heart::before {
  left: 0;
  transform: rotate(-45deg);
  transform-origin: 100% 100%;
}
.deco-heart::after {
  left: 22rpx;
  transform: rotate(45deg);
  transform-origin: 0 100%;
}
.deco-heart--l {
  left: 70rpx;
  top: 560rpx;
  transform: scale(0.9);
}
.deco-heart--r {
  right: 96rpx;
  top: 380rpx;
  transform: scale(0.7) rotate(12deg);
  opacity: 0.5;
}

/* 书本 */
.deco-book {
  right: 56rpx;
  top: 210rpx;
  width: 88rpx;
  height: 62rpx;
  background: var(--white);
  border-radius: var(--radius-xs);
  opacity: 0.85;
  transform: rotate(-8deg);
}
.deco-book::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 4rpx;
  bottom: 4rpx;
  width: 4rpx;
  margin-left: -2rpx;
  background: #b9d9f2;
  border-radius: 4rpx;
}
.deco-book::after {
  content: "";
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 16rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #dcecf8;
  box-shadow: 0 14rpx 0 #dcecf8, 0 28rpx 0 #dcecf8;
}

/* 飞鸟：两段弧线组成 */
.deco-bird {
  width: 40rpx;
  height: 20rpx;
  opacity: 0.8;
}
.deco-bird::before,
.deco-bird::after {
  content: "";
  position: absolute;
  top: 0;
  width: 20rpx;
  height: 20rpx;
  border: 5rpx solid var(--white);
  border-bottom: none;
  border-left: none;
  border-radius: 0 100% 0 0;
}
.deco-bird::before {
  left: 0;
  transform: skewY(10deg);
}
.deco-bird::after {
  left: 17rpx;
  transform: scaleX(-1) skewY(10deg);
}
.deco-bird--1 {
  left: 60rpx;
  top: 230rpx;
}
.deco-bird--2 {
  left: 130rpx;
  top: 180rpx;
  transform: scale(0.7);
  opacity: 0.6;
}
.deco-bird--3 {
  right: 200rpx;
  top: 300rpx;
  transform: scale(0.55);
  opacity: 0.5;
}

/* ---------- 品牌区 ---------- */
.login__hero {
  position: relative;
  padding: 90rpx 40rpx 50rpx;
  text-align: center;
  color: var(--white);
  z-index: 1;
}

.login__logo-box {
  width: 176rpx;
  height: 176rpx;
  margin: 0 auto 28rpx;
  border-radius: 40rpx;
  background: var(--white);
  padding: 26rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 36rpx rgba(20, 80, 140, 0.18);
}

.login__logo {
  width: 100%;
  height: 100%;
  display: block;
}

.login__brand {
  font-size: 52rpx;
  font-weight: var(--fw-bold);
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 16rpx rgba(30, 100, 160, 0.2);
}

.login__slogan {
  font-size: var(--fs-md);
  opacity: 0.92;
  margin-top: 14rpx;
  letter-spacing: 2rpx;
}

/* ---------- 登录卡片 ---------- */
.login__card {
  position: relative;
  z-index: 1;
  margin: 30rpx 40rpx 0;
  background: var(--white);
  border-radius: var(--radius-2xl);
  padding: 48rpx 44rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(30, 90, 150, 0.12);
}

.login__title {
  font-size: var(--fs-4xl);
  font-weight: var(--fw-bold);
  color: var(--text);
  line-height: 1.3;
}

/* 标题下的装饰下划线：渐变短条 + 小圆点 */
.login__title-accent {
  position: relative;
  width: 88rpx;
  height: 10rpx;
  margin: 14rpx 0 36rpx;
  border-radius: var(--radius-sm);
  background: var(--grad-brand);
}
.login__title-accent-dot {
  position: absolute;
  right: -16rpx;
  top: 2rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #f59e4c;
}

/* ---------- 输入框：胶囊样式 + 左侧图标 ---------- */
.field {
  margin-bottom: 30rpx;
}

.field__label {
  font-size: var(--fs-lg);
  color: #2b3648;
  margin-bottom: 16rpx;
  font-weight: var(--fw-medium);
}

.input-pill {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 30rpx;
  background: #f1f6fc;
  border: 2rpx solid transparent;
  border-radius: var(--radius-pill);
  transition: border-color 0.15s, background 0.15s;
}

.input-pill--active {
  background: #eef4fd;
  border-color: var(--primary-bright);
}

.input-pill__icon {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  background-color: transparent;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 40rpx 40rpx;
}

/* 内联 SVG 图标（base64）：人形 / 锁 */
.input-pill__icon--user {
  background-image: url("data:image/svg+xml;base64,");
}
.input-pill__icon--lock {
  background-image: url("data:image/svg+xml;base64,");
}

.input-pill__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: var(--fs-xl);
  color: var(--text);
}

.login__placeholder {
  color: #a9b8ca;
}

/* 密码可见切换 */
.login__toggle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4rpx 0 20rpx;
}
.login__toggle--hover {
  opacity: 0.6;
}

.login__eye {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

/* ---------- 错误提示 ---------- */
.login__error {
  background: var(--danger-light);
  color: var(--danger);
  font-size: var(--fs-base);
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 24rpx;
}

/* ---------- 登录按钮：蓝色渐变胶囊 ---------- */
.login__submit {
  margin-top: 16rpx;
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  background: var(--grad-brand);
  color: var(--white);
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 28rpx rgba(29, 95, 208, 0.32);
  line-height: 1;
}
.login__submit::after {
  border: none;
}
.login__submit[disabled] {
  opacity: 0.6;
  color: var(--white);
  background: var(--grad-brand);
}

/* ---------- 说明与协议 ---------- */
.login__note {
  margin-top: 32rpx;
  font-size: var(--fs-sm);
  color: #8b98a9;
  text-align: center;
  line-height: 1.6;
}

.login__agree {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.login__checkbox-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-right: 12rpx;
  margin-right: 0;
}

.login__checkbox {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #c3cfdd;
  border-radius: var(--radius-xs);
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.login__checkbox--on {
  background: var(--primary);
  border-color: var(--primary);
}
.login__checkbox-check {
  width: 14rpx;
  height: 8rpx;
  border-left: 4rpx solid var(--white);
  border-bottom: 4rpx solid var(--white);
  transform: rotate(-45deg) translateY(-2rpx);
}

.login__agree-text {
  font-size: var(--fs-sm);
  color: var(--text-muted);
}

/* 协议名称：可点击，带下划线与按压反馈，明确「可点」 */
.login__agree-link {
  color: var(--orange-deep);
  text-decoration: underline;
  text-decoration-color: rgba(201, 106, 21, 0.4);
  padding: 4rpx 2rpx;
}
.login__agree-link:active {
  opacity: 0.6;
}
