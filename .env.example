# Copy to .env.local for local development. Never commit real credentials.
PORT=3123
DATA_DIR=./data
DATABASE_URL=
DB_POOL_MAX=5
ZHIPU_API_KEY=
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_CHAT_MODEL=glm-4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_REPORT_TIMEOUT_MS=45000
AI_EMBEDDING_TIMEOUT_MS=30000
AI_CHAT_TIMEOUT_MS=45000
AI_STREAM_TIMEOUT_MS=90000
# 是否在启动时补演示任务（默认 0=不补）。
# 生产库务必保持关闭：任务只能由教师/管理员点「确认发布」后写入，
# 否则每次启动或跨周都会凭空多出任务，管理员端看起来像「未经确认就已发布」。
# 本地 SQLite 演示库可设 1。
DEMO_SEED=0
